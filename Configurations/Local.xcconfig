#include "Common.xcconfig"
#include "DevIdentity.xcconfig"
PIPPIPGO_APP_ENVIRONMENT = local
PIPPIPGO_DISPLAY_NAME = PipPipGo Local
// When this host changes, also update its NSExceptionDomains key in Debug-Info.plist.
PIPPIPGO_LAN_HOST = 192.168.0.208
PIPPIPGO_BACKEND_BASE_URL = http:$(PIPPIPGO_URL_SLASH)$(PIPPIPGO_URL_SLASH)$(PIPPIPGO_LAN_HOST):8765
PIPPIPGO_BACKEND_BASE_URL[sdk=iphonesimulator*] = http:$(PIPPIPGO_URL_SLASH)$(PIPPIPGO_URL_SLASH)localhost:8765
