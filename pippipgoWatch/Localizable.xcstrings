        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở PipPipGo trên iPhone."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Buksan ang PipPipGo sa iyong iPhone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone’unuzda PipPipGo’yu açın."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте PipPipGo на iPhone."
          }
        },
        "fil-PH": {
          "stringUnit": {
            "state": "translated",
            "value": "Buksan ang PipPipGo sa iyong iPhone."
          }
        }
