          "stringUnit": {
            "state": "translated",
            "value": "iPhoneでサインインし、設定を完了してください。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi e completa la configurazione sul tuo iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在iPhone上登录并完成设置。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone에서 로그인하고 설정을 완료하세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập và hoàn tất thiết lập trên iPhone."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mag-sign in at tapusin ang pag-setup sa iyong iPhone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone’unuzda giriş yapıp kurulumu tamamlayın."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите и завершите настройку на iPhone."
          }
        },
        "fil-PH": {
          "stringUnit": {
            "state": "translated",
            "value": "Mag-sign in at tapusin ang pag-setup sa iyong iPhone."
          }
        }
      }
    },
