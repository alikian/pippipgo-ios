    "Sign in and finish setup on your iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in and finish setup on your iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión y completa la configuración en tu iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous et terminez la configuration sur votre iPhone."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در آیفون وارد شوید و راه‌اندازی را کامل کنید."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول وأكمل الإعداد على iPhone."
          }
        },
