    "Waiting for a fresh location. It will retry automatically." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بانتظار موقع جديد. ستتم إعادة المحاولة تلقائيًا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waiting for a fresh location. It will retry automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esperando una ubicación actualizada. Se volverá a intentar automáticamente."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در انتظار موقعیت مکانی جدید هستیم. دوباره به‌طور خودکار تلاش می‌کنیم."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naghihintay ng bagong lokasyon. Awtomatiko itong susubukan ulit."
          }
        },
        "fil-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naghihintay ng bagong lokasyon. Awtomatiko itong susubukang muli."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En attente d’une position récente. Une nouvelle tentative sera effectuée automatiquement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In attesa di una posizione aggiornata. Riproveremo automaticamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最新の位置情報を取得しています。自動的に再試行します。"
