    "Preferences changed elsewhere. Load the latest and review your edit." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيّرت التفضيلات في مكان آخر. حمّل أحدث نسخة وراجع تعديلاتك."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preferences changed elsewhere. Load the latest and review your edit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las preferencias cambiaron en otro lugar. Carga la versión más reciente y revisa tus cambios."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترجیحات در جای دیگری تغییر کرده‌اند. آخرین نسخه را بارگیری کنید و تغییرتان را بازبینی کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "May nagbago sa mga kagustuhan mo sa ibang lugar. I-load ang pinakabago at suriin ang mga pagbabago mo."
          }
        },
        "fil-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nabago ang mga kagustuhan sa ibang lugar. I-load ang pinakabago at suriin ang mga edit mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les préférences ont été modifiées ailleurs. Chargez la dernière version et vérifiez vos modifications."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le preferenze sono state modificate altrove. Carica la versione più recente e rivedi le modifiche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定が別の場所で変更されました。最新の内容を読み込み、編集内容を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 곳에서 환경설정이 변경되었어요. 최신 내용을 불러온 다음 수정 사항을 확인해 주세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройки изменены в другом месте. Загрузите последнюю версию и проверьте свои изменения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tercihler başka bir yerde değiştirildi. En güncel hâlini yükleyip düzenlemenizi gözden geçirin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tùy chọn đã thay đổi ở nơi khác. Tải bản mới nhất và xem lại nội dung bạn chỉnh sửa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "偏好设置已在其他地方更改。请加载最新内容并检查你的编辑。"
          }
        }
      }
    },
    "Preferred language (optional)" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
