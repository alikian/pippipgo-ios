    "Start translation, then take turns speaking. Pip says each sentence in the other language." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابدأ الترجمة، ثم تناوبا على الكلام. يترجم Pip كل جملة إلى اللغة الأخرى."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start translation, then take turns speaking. Pip says each sentence in the other language."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia la traducción y hablad por turnos. Pip dice cada frase en el otro idioma."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترجمه را شروع کنید و به نوبت صحبت کنید. پیپ هر جمله را به زبان دیگر می‌گوید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simulan ang pagsasalin, pagkatapos ay magpalitan sa pagsasalita. Sinasabi ni Pip ang bawat pangungusap sa kabilang wika."
          }
        },
        "fil-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simulan ang pagsasalin, saka magsalitan sa pagsasalita. Sasabihin ni Pip ang bawat pangungusap sa kabilang wika."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Démarre la traduction, puis parlez à tour de rôle. Pip dit chaque phrase dans l’autre langue."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvia la traduzione, poi parlate a turno. Pip pronuncia ogni frase nell’altra lingua."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "翻訳を開始し、交互に話してください。Pipが各文をもう一方の言語で読み上げます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "번역을 시작한 다음 번갈아 말하세요. Pip이 각 문장을 다른 언어로 말해 줍니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начните перевод, затем говорите по очереди. Pip будет произносить каждую фразу на другом языке."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çeviriyi başlatın, sonra sırayla konuşun. Pip her cümleyi diğer dilde seslendirir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bắt đầu dịch, rồi lần lượt nói. Pip sẽ đọc mỗi câu bằng ngôn ngữ còn lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
