        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "از Apple Maps روی iPhone شما استفاده می‌کند. چیزی از اینجا به PipPipGo ارسال نمی‌شود."
          }
        },
        "fil" : {
          "stringUnit" : {
