    "Pip tells you about the places around you as you walk or drive, matched to what you enjoy." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip tells you about the places around you as you walk or drive, matched to what you enjoy."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip هنگام پیاده‌روی یا رانندگی، درباره مکان‌های اطرافتان و متناسب با علایقتان برایتان می‌گوید."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歩くときも運転中も、Pipがあなたの好みに合わせて周りの場所を紹介します。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip te cuenta sobre los lugares que te rodean mientras caminas o conduces, según lo que te gusta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip vous parle des lieux autour de vous pendant que vous marchez ou conduisez, selon vos goûts."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip ti racconta i luoghi intorno a te mentre cammini o guidi, in base a ciò che ti piace."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "步行或开车时，Pip 会根据你的喜好介绍身边的地点。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "걷거나 운전할 때 Pip이 취향에 맞춰 주변 장소를 알려 줘요."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip kể cho bạn về những nơi xung quanh khi bạn đi bộ hoặc lái xe, theo sở thích của bạn."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikinukuwento ni Pip ang mga lugar sa paligid mo habang naglalakad o nagmamaneho ka, ayon sa gusto mo."
          }
        },
        "fil-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikinukuwento ni Pip ang mga lugar sa paligid mo habang naglalakad o nagmamaneho ka, ayon sa gusto mo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip, yürürken veya araç kullanırken çevrenizdeki yerleri zevkinize göre anlatır."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يخبرك Pip عن الأماكن من حولك وأنت تمشي أو تقود، بما يناسب ما تحب."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip рассказывает о местах вокруг, пока вы идёте или едете, с учётом ваших интересов."
          }
        }
      }
    },
    "Ask about food, directions or your plans, in your own language. Pip learns what you like." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask about food, directions or your plans, in your own language. Pip learns what you like."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "درباره غذا، مسیر یا برنامه‌هایتان به زبان خودتان بپرسید. Pip سلیقه شما را یاد می‌گیرد."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "食事、道案内、予定について、あなたの言葉で聞いてください。Pipはあなたの好みを覚えます。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregunta sobre comida, indicaciones o tus planes, en tu idioma. Pip aprende lo que te gusta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posez vos questions sur les repas, les itinéraires ou vos projets, dans votre langue. Pip apprend vos goûts."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedi di cibo, indicazioni o dei tuoi programmi, nella tua lingua. Pip impara cosa ti piace."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用你的语言询问美食、路线或计划。Pip 会了解你的喜好。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음식, 길 안내, 일정을 내 언어로 물어보세요. Pip이 취향을 배워요."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hỏi về đồ ăn, chỉ đường hay kế hoạch bằng ngôn ngữ của bạn. Pip sẽ hiểu bạn thích gì."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magtanong tungkol sa pagkain, direksyon o mga plano mo, sa sarili mong wika. Natututunan ni Pip ang gusto mo."
          }
        },
        "fil-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magtanong tungkol sa pagkain, direksyon o mga plano mo, sa sarili mong wika. Natututunan ni Pip ang gusto mo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yemek, yol tarifi veya planlarınızı kendi dilinizde sorun. Pip neleri sevdiğinizi öğrenir."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسأل عن الطعام أو الاتجاهات أو خططك بلغتك. يتعلم Pip ما تحب."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спрашивайте о еде, маршрутах или планах на своём языке. Pip узнаёт, что вам нравится."
          }
        }
      }
    },
