    "Tap Start translation once, then speak naturally. Pip translates aloud in real time—no need to hold a button." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap Start translation once, then speak naturally. Pip translates aloud in real time—no need to hold a button."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca Iniciar traducción una vez y habla con naturalidad. Pip traduce en voz alta en tiempo real, sin mantener pulsado ningún botón."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یک بار روی شروع ترجمه بزنید، سپس طبیعی صحبت کنید. پیپ هم‌زمان با صدای بلند ترجمه می‌کند؛ نیازی به نگه داشتن دکمه نیست."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez Démarrer la traduction une fois, puis parlez naturellement. Pip traduit à voix haute en temps réel, sans maintenir de bouton enfoncé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca Avvia traduzione una volta, poi parla naturalmente. Pip traduce ad alta voce in tempo reale, senza tenere premuto un pulsante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「翻訳を開始」を一度タップして、自然に話してください。Pipがリアルタイムで音声翻訳します。ボタンを押し続ける必要はありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点一次“开始翻译”，然后自然说话。Pip 会实时朗读翻译，无需按住按钮。"
          }
        }
      }
    },
