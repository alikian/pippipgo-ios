    "This backend does not support headphone mode yet. Use the updated local backend or turn headphone mode off." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This backend does not support headphone mode yet. Use the updated local backend or turn headphone mode off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este backend aún no es compatible con el modo auriculares. Usa el backend local actualizado o desactiva el modo auriculares."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این بخشِ پشتیبان هنوز از حالت هدفون پشتیبانی نمی‌کند. از بخشِ پشتیبان محلیِ به‌روزشده استفاده کنید یا حالت هدفون را خاموش کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce serveur ne prend pas encore en charge le mode casque. Utilisez la version mise à jour du serveur local ou désactivez le mode casque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo servizio backend non supporta ancora la modalità cuffie. Usa il backend locale aggiornato oppure disattiva la modalità cuffie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このバックエンドはヘッドフォンモードにまだ対応していません。最新のローカルバックエンドを使うか、ヘッドフォンモードをオフにしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此后端暂不支持耳机模式。请使用更新后的本地后端，或关闭耳机模式。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 백엔드는 아직 헤드폰 모드를 지원하지 않습니다. 업데이트된 로컬 백엔드를 사용하거나 헤드폰 모드를 끄세요."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máy chủ phụ trợ này chưa hỗ trợ chế độ tai nghe. Hãy dùng máy chủ phụ trợ cục bộ đã cập nhật hoặc tắt chế độ tai nghe."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi pa sinusuportahan ng backend na ito ang headphone mode. Gamitin ang na-update na lokal na backend o i-off ang headphone mode."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu arka uç henüz kulaklık modunu desteklemiyor. Güncellenmiş yerel arka ucu kullanın veya kulaklık modunu kapatın."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا النظام الخلفي لا يدعم وضع سماعات الرأس بعد. استخدم النظام الخلفي المحلي المحدّث أو أوقف وضع سماعات الرأس."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот сервер пока не поддерживает режим наушников. Используйте обновлённый локальный сервер или отключите режим наушников."
          }
        },
        "fil-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi pa sinusuportahan ng backend na ito ang headphone mode. Gamitin ang na-update na lokal na backend o i-off ang headphone mode."
          }
        }
      }
    },
