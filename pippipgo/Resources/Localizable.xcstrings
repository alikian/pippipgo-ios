    "Uses Apple Maps on your iPhone. Nothing here is sent to PipPipGo." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم خرائط Apple على iPhone. لا يُرسل أي شيء من هنا إلى PipPipGo."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses Apple Maps on your iPhone. Nothing here is sent to PipPipGo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Apple Maps en tu iPhone. Nada de esto se envía a PipPipGo."
          }
