    "Use numbers with up to two decimal places, or whole yen for JPY. Negative amounts are not supported." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم أرقامًا بمنزلتين عشريتين كحد أقصى، أو أعدادًا صحيحة للين الياباني (JPY). لا تُقبل المبالغ السالبة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use numbers with up to two decimal places, or whole yen for JPY. Negative amounts are not supported."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa números con hasta dos decimales, o yenes enteros para JPY. No se admiten importes negativos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عددها را با حداکثر دو رقم اعشار وارد کنید؛ برای ین ژاپن عدد صحیح وارد کنید. مبلغ منفی پذیرفته نمی‌شود."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gumamit ng mga numerong may hanggang dalawang decimal place, o mga buumbilang na yen para sa JPY. Hindi pinapayagan ang mga negatibong halaga."
          }
        },
        "fil-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gumamit ng mga numerong may hanggang dalawang decimal place, o buong yen para sa JPY. Hindi pinapayagan ang mga negatibong halaga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise des nombres avec deux décimales au maximum, ou des yens entiers pour JPY. Les montants négatifs ne sont pas acceptés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa numeri con al massimo due decimali, oppure yen interi per JPY. Gli importi negativi non sono ammessi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小数点以下2桁までの数値を使用してください。日本円は整数で入力してください。負の金額は使用できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "소수점 이하 최대 두 자리까지 입력하거나, JPY의 경우 정수로 입력하세요. 음수는 지원되지 않습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Укажите число с двумя знаками после запятой или целое число для японских иен (JPY). Отрицательные суммы не поддерживаются."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En fazla iki ondalık basamak içeren sayılar veya JPY için tam sayı kullanın. Negatif tutarlar desteklenmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhập số có tối đa hai chữ số thập phân, hoặc số nguyên yên Nhật (JPY). Không hỗ trợ số âm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请输入最多两位小数的金额，日元（JPY）须为整数。不支持负数金额。"
          }
        }
      }
    },
