    "Driving? Keep your eyes on the road and talk to Pip instead." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تقود؟ أبقِ عينيك على الطريق وتحدث إلى Pip بدلًا من ذلك."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Driving? Keep your eyes on the road and talk to Pip instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Conduces? Mantén la vista en la carretera y habla con Pip."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در حال رانندگی هستید؟ چشمتان به جاده باشد و به‌جای آن با Pip صحبت کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagmamaneho? Ituon ang mata sa daan at kausapin na lang si Pip."
          }
        },
        "fil-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagmamaneho? Ituon ang mata sa daan at kausapin na lang si Pip."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous conduisez ? Gardez les yeux sur la route et parlez à Pip."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stai guidando? Tieni gli occhi sulla strada e parla con Pip."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "運転中ですか？道路から目を離さず、Pipには声で話しかけてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "운전 중인가요? 도로에서 눈을 떼지 말고 Pip에게 말로 하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За рулём? Смотрите на дорогу и говорите с Pip голосом."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Araç mı kullanıyorsunuz? Gözünüzü yoldan ayırmayın ve Pip'le konuşun."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đang lái xe? Hãy tập trung nhìn đường và nói chuyện với Pip."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在开车？请注视路面，改用语音和 Pip 交流。"
          }
        }
      }
    },
