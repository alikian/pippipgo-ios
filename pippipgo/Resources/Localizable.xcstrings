    "How will you get there—fly, drive, train, or something else?" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How will you get there—fly, drive, train, or something else?"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "چطور می‌روید—هواپیما، ماشین، قطار یا راه دیگری؟"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Cómo llegarás: en avión, en coche, en tren o de otra forma?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comment comptez-vous vous y rendre : en avion, en voiture, en train ou autrement ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come ci arriverai: in aereo, in auto, in treno o in un altro modo?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どうやって行きますか？飛行機、車、電車、それとも別の方法ですか？"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你打算怎么去——坐飞机、开车、坐火车，还是其他方式？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어떻게 이동할까요? 비행기, 자동차, 기차, 아니면 다른 수단인가요?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn sẽ đến đó bằng cách nào—máy bay, ô tô, tàu hỏa hay phương tiện khác?"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paano ka makakarating—sa eroplano, kotse, tren, o iba pa?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oraya nasıl gideceksin—uçakla, arabayla, trenle ya da başka bir şekilde?"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كيف ستصل إلى هناك—بالطائرة أم بالسيارة أم بالقطار أم بوسيلة أخرى؟"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как вы доберётесь — на самолёте, машине, поезде или как-то иначе?"
          }
        },
        "fil-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paano ka pupunta roon—lilipad, magmamaneho, sasakay ng tren, o iba pa?"
          }
        }
      }
    },
