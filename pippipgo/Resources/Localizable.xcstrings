    "Review local dates, times and time zones before saving. Leave unknown fields blank; your plan will stay provisional." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa las fechas, horas y zonas horarias locales antes de guardar. Deja en blanco los campos desconocidos; tu plan seguirá siendo provisional."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پیش از ذخیره، تاریخ‌ها، ساعت‌ها و مناطق زمانی محلی را بررسی کنید. موارد نامشخص را خالی بگذارید؛ برنامه موقت باقی می‌ماند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifie les dates, heures et fuseaux horaires locaux avant d’enregistrer. Laisse les champs inconnus vides ; ton programme restera provisoire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla date, orari e fusi orari locali prima di salvare. Lascia vuoti i campi sconosciuti; il piano resterà provvisorio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存前に現地の日付、時刻、タイムゾーンを確認してください。不明な項目は空欄にしてください。プランは仮のままになります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存前请检查当地日期、时间和时区。未知项目请留空；计划将保持暂定状态。"
          }
        }
      }
    },
