          }
        }
      }
    },
    "I'll travel with you, help when you need me, and get to know what you like along the way." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I'll travel with you, help when you need me, and get to know what you like along the way."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viajaré contigo, te ayudaré cuando lo necesites y conoceré tus gustos por el camino."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "همراهت سفر می‌کنم، هر وقت نیاز داشته باشی کمک می‌کنم و در طول راه سلیقه‌ات را می‌شناسم."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je voyagerai avec toi, t’aiderai quand tu en auras besoin et découvrirai tes goûts en chemin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viaggerò con te, ti aiuterò quando ne avrai bisogno e conoscerò i tuoi gusti lungo la strada."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旅に寄り添い、必要なときにお手伝いしながら、あなたの好みを少しずつ学びます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我会陪你旅行，在需要时提供帮助，并在途中了解你的喜好。"
          }
        }
      }
    },
    "I'm Pip. I'll learn what matters to you, and you can correct me anytime." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I'm Pip. I'll learn what matters to you, and you can correct me anytime."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soy Pip. Aprenderé qué te importa y puedes corregirme en cualquier momento."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من پیپ هستم. یاد می‌گیرم چه چیزهایی برایتان مهم است و هر وقت خواستید می‌توانید اصلاحم کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je suis Pip. Je découvrirai ce qui compte pour toi, et tu peux me corriger à tout moment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sono Pip. Imparerò cosa conta per te e potrai correggermi in qualsiasi momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pipです。あなたが大切にしていることを学びます。いつでも訂正してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我是 Pip。我会了解你重视的事情，你随时可以纠正我。"
          }
        }
      }
    },
    "I'm Pip. Let's make this trip feel like you." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I'm Pip. Let's make this trip feel like you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soy Pip. Hagamos que este viaje refleje quién eres."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من پیپ هستم. بیا این سفر را به سلیقهٔ تو بسازیم."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je suis Pip. Créons un voyage qui te ressemble."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sono Pip. Rendiamo questo viaggio davvero tuo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pipです。あなたらしい旅にしましょう。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我是 Pip。一起打造属于你的旅行。"
          }
        }
      }
    },
