    "Changing language keeps your trips and memories." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيير اللغة يُبقي رحلاتك وذكرياتك."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changing language keeps your trips and memories."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambiar el idioma conserva tus viajes y recuerdos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "با تغییر زبان، سفرها و خاطره‌هایت حفظ می‌شوند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mananatili ang mga biyahe at alaala mo kapag pinalitan mo ang wika."
          }
        },
        "fil-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapag binago mo ang wika, mananatili ang mga biyahe at alaala mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changer de langue conserve tes voyages et tes souvenirs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambiare lingua conserva i tuoi viaggi e ricordi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "言語を変更しても旅行や記憶は保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "언어를 변경해도 여행과 추억은 그대로 유지됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смена языка не затронет ваши поездки и воспоминания."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dil değiştirildiğinde seyahatleriniz ve anılarınız korunur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đổi ngôn ngữ sẽ không làm mất các chuyến đi và kỷ niệm của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改语言不会删除旅行或记忆。"
          }
        }
      }
    },
