    "A trip you loved—what made it special?" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A trip you loved—what made it special?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué viaje te encantó y qué lo hizo especial?"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سفری که دوستش داشتی—چه چیزی خاصش کرد؟"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un voyage que vous avez adoré : qu’est-ce qui l’a rendu si spécial ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un viaggio che hai amato: cosa lo ha reso speciale?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心に残った旅は？特別だった理由は？"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一次让你难忘的旅行——特别之处是什么？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정말 좋았던 여행이 있나요? 무엇이 특별했나요?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một chuyến đi bạn yêu thích—điều gì khiến chuyến đi ấy đặc biệt?"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isang biyahe na nagustuhan mo—ano ang nagpas espesyal dito?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çok sevdiğin bir seyahat—onu özel kılan neydi?"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رحلة أحببتها—ما الذي جعلها مميزة؟"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вспомните поездку, которая вам понравилась. Что сделало её особенной?"
          }
        },
        "fil-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isang biyaheng nagustuhan mo—ano ang nagpaspecial dito?"
          }
        }
      }
    },
