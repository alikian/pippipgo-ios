    "Add a trip yourself, or ask Pip to plan one with you." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف رحلة بنفسك، أو اطلب من Pip التخطيط لها معك."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add a trip yourself, or ask Pip to plan one with you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade un viaje tú mismo o pídele a Pip que planifique uno contigo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خودتان سفری اضافه کنید یا از پیپ بخواهید با شما برنامه‌ریزی کند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magdagdag ng biyahe nang mag-isa o hilingin kay Pip na magplano kayo nang magkasama."
          }
        },
        "fil-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magdagdag ng biyahe, o hilingin kay Pip na magplano nito kasama mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez un voyage vous-même ou demandez à Pip d’en planifier un avec vous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi un viaggio o chiedi a Pip di pianificarne uno con te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分で旅行を追加するか、Pipと一緒に計画しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "직접 여행을 추가하거나 Pip에게 함께 계획해 달라고 요청해 보세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте поездку самостоятельно или попросите Пипа спланировать её вместе с вами."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kendin bir gezi ekle veya Pip’ten birlikte planlamasını iste."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tự thêm chuyến đi hoặc nhờ Pip cùng bạn lên kế hoạch."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自己添加旅行，或让 Pip 和你一起规划。"
          }
        }
      }
    },
