    "You can correct Pip anytime. Temporary trip needs stay separate from what you want remembered." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can correct Pip anytime. Temporary trip needs stay separate from what you want remembered."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes corregir a Pip en cualquier momento. Las necesidades temporales del viaje se mantienen separadas de lo que quieres que recuerde."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هر وقت بخواهی می‌توانی پیپ را اصلاح کنی. نیازهای موقت سفر از چیزهایی که می‌خواهی به یاد بمانند جدا هستند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu peux corriger Pip à tout moment. Les besoins temporaires du voyage restent séparés de ce que tu souhaites conserver en mémoire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi correggere Pip in qualsiasi momento. Le esigenze temporanee del viaggio restano separate da ciò che vuoi ricordare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pipはいつでも訂正できます。一時的な旅行のニーズと覚えておいてほしいことは別に管理されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你随时可以纠正 Pip。临时旅行需求与你希望记住的信息分开保留。"
          }
        }
      }
    },
