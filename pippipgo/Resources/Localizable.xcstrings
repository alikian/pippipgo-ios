    "Location found. Nearby address is unavailable; lookup will retry automatically." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location found. Nearby address is unavailable; lookup will retry automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubicación encontrada. No se pudo obtener la dirección cercana; se volverá a intentar automáticamente."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "موقعیت مکانی پیدا شد. نشانی نزدیک در دسترس نیست؛ دوباره به‌طور خودکار تلاش می‌کنیم."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Position détectée. Adresse à proximité indisponible ; une nouvelle recherche sera effectuée automatiquement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posizione trovata. L’indirizzo nelle vicinanze non è disponibile; riproveremo automaticamente a trovarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置情報を取得しました。近くの住所を取得できません。自動的に再試行します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已获取位置，但无法获取附近地址；将自动重试。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위치를 찾았습니다. 주변 주소를 확인할 수 없어 자동으로 다시 조회합니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã tìm thấy vị trí. Không có địa chỉ lân cận; hệ thống sẽ tự động thử tra cứu lại."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nahanap ang lokasyon. Hindi available ang kalapit na address; awtomatikong susubukan ulit itong hanapin."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konum bulundu. Yakındaki adres kullanılamıyor; arama otomatik olarak yeniden denenecek."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تحديد الموقع. العنوان القريب غير متاح؛ ستُعاد محاولة البحث تلقائيًا."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Геопозиция определена. Адрес поблизости недоступен; поиск будет автоматически повторён."
          }
        },
        "fil-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nahanap ang lokasyon. Hindi available ang kalapit na address; awtomatikong susubukang hanapin ito muli."
          }
        }
      }
    },
