    "Use Apple, Google or email and password. When creating an account, enter your email address as both username and email." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم Apple أو Google أو البريد الإلكتروني وكلمة المرور. عند إنشاء حساب، أدخل عنوان بريدك الإلكتروني في حقلي اسم المستخدم والبريد الإلكتروني."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Apple, Google or email and password. When creating an account, enter your email address as both username and email."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Apple, Google o correo y contraseña. Al crear una cuenta, introduce tu correo tanto como nombre de usuario como correo electrónico."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "با Apple، گوگل یا ایمیل و رمز عبور وارد شوید. هنگام ساخت حساب، نشانی ایمیل را هم در نام کاربری و هم در ایمیل وارد کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gumamit ng Apple, Google o email at password. Kapag gagawa ng account, ilagay ang iyong email address bilang username at email."
          }
        },
        "fil-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gumamit ng Apple, Google o email at password. Kapag gumagawa ng account, ilagay ang email address mo bilang username at email."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez Apple, Google ou un e-mail et un mot de passe. À la création du compte, saisissez votre e-mail comme nom d’utilisateur et comme adresse e-mail."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Apple, Google o email e password. Quando crei un account, inserisci il tuo indirizzo email sia come nome utente sia come email."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple、Googleまたはメールアドレスとパスワードを使用します。アカウント作成時は、ユーザー名とメールアドレスの両方にメールアドレスを入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple, Google 또는 이메일과 비밀번호를 사용하세요. 계정을 만들 때는 이메일 주소를 사용자 이름과 이메일에 모두 입력하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте Apple, Google или адрес электронной почты и пароль. При создании аккаунта укажите свой адрес электронной почты и в поле имени пользователя, и в поле электронной почты."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple'ı, Google'ı veya e-posta adresinizi ve parolanızı kullanın. Hesap oluştururken e-posta adresinizi hem kullanıcı adı hem de e-posta olarak girin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng Apple, Google hoặc email và mật khẩu. Khi tạo tài khoản, hãy nhập địa chỉ email làm cả tên người dùng lẫn email."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 Apple、Google 或邮箱和密码。创建账户时，请在用户名和邮箱栏中都输入你的邮箱地址。"
          }
        }
      }
    },
