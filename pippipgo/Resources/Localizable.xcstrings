    "Preview, choose a voice, then Save & Done. Applies to your next Pip or translation session." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preview, choose a voice, then Save & Done. Applies to your next Pip or translation session."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escucha la vista previa, elige una voz y luego toca Guardar y listo. Se aplicará a tu próxima sesión con Pip o de traducción."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پیش‌نمایش کن، یک صدا انتخاب کن، بعد «ذخیره و پایان» را بزن. این تغییرات برای جلسه بعدی‌ات با Pip یا ترجمه اعمال می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affichez un aperçu, choisissez une voix, puis touchez « Enregistrer et terminer ». Ces réglages s’appliqueront à votre prochaine session avec Pip ou de traduction."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visualizza l’anteprima, scegli una voce, poi tocca Salva e fine. Le modifiche si applicheranno alla prossima sessione con Pip o di traduzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレビューして声を選び、保存して完了します。次回のPipまたは翻訳セッションに適用されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "预览并选择语音，然后点“保存并完成”。此设置将应用于你下次与 Pip 交流或使用翻译时。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미리 듣고 목소리를 선택한 다음, 저장 및 완료를 누르세요. 다음 Pip 이용 또는 번역 세션부터 적용돼요."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nghe thử, chọn giọng nói, rồi chọn Lưu & Xong. Áp dụng cho phiên Pip hoặc phiên dịch tiếp theo của bạn."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mag-preview, pumili ng boses, pagkatapos ay i-tap ang I-save at Tapos. Gagamitin ito sa susunod mong sesyon kay Pip o sa pagsasalin."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önizleyin, bir ses seçin, ardından Kaydet ve Bitir’e dokunun. Bu seçim, sonraki Pip veya çeviri oturumunuzda geçerli olur."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استمع إلى المعاينة، واختر صوتًا، ثم اضغط على «حفظ وإنهاء». سيُطبّق ذلك على جلسة بيب أو الترجمة التالية."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прослушайте варианты, выберите голос, затем нажмите «Сохранить и завершить». Настройка будет применена при следующем разговоре с Pip или сеансе перевода."
          }
        },
        "fil-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mag-preview, pumili ng boses, pagkatapos ay I-save at Tapos na. Mailalapat ito sa susunod mong session kay Pip o sa pagsasalin."
          }
        }
      }
    },
