    "Deletion could not be confirmed. Your account may already be disabled. Check your connection and retry deletion." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تأكيد الحذف. قد يكون حسابك قد عُطّل بالفعل. تحقق من اتصالك وحاول الحذف مجددًا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deletion could not be confirmed. Your account may already be disabled. Check your connection and retry deletion."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo confirmar la eliminación. Es posible que tu cuenta ya esté desactivada. Comprueba tu conexión y vuelve a intentarlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حذف تأیید نشد. ممکن است حساب شما از قبل غیرفعال شده باشد. اتصال خود را بررسی کنید و دوباره برای حذف تلاش کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi makumpirma ang pag-delete. Maaaring na-disable na ang iyong account. Tingnan ang koneksyon mo at subukang i-delete itong muli."
          }
        },
        "fil-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi nakumpirma ang pagtanggal. Maaaring naka-disable na ang iyong account. Tingnan ang koneksyon mo at subukang muli ang pagtanggal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suppression n’a pas pu être confirmée. Votre compte est peut-être déjà désactivé. Vérifiez votre connexion et réessayez la suppression."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile confermare l’eliminazione. Il tuo account potrebbe essere già disattivato. Controlla la connessione e riprova a eliminarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削除を確認できませんでした。アカウントはすでに無効になっている可能性があります。接続を確認して、削除を再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "삭제를 확인할 수 없습니다. 계정이 이미 비활성화되었을 수 있습니다. 연결을 확인하고 삭제를 다시 시도하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось подтвердить удаление. Возможно, аккаунт уже отключён. Проверьте подключение и повторите удаление."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silme işlemi doğrulanamadı. Hesabınız zaten devre dışı bırakılmış olabilir. Bağlantınızı kontrol edip silme işlemini yeniden deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể xác nhận đã xóa. Tài khoản của bạn có thể đã bị vô hiệu hóa. Hãy kiểm tra kết nối rồi thử xóa lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法确认删除是否成功。你的账户可能已停用。请检查网络连接，然后重试删除。"
          }
        }
      }
    },
