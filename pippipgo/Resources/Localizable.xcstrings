    "Sync cursor must not be negative." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync cursor must not be negative."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El cursor de sincronización no puede ser negativo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مقدار نشانگر همگام‌سازی نباید منفی باشد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le curseur de synchronisation ne peut pas être négatif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il cursore di sincronizzazione non può essere negativo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期カーソルは負の値にできません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步游标不能为负数。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동기화 커서는 음수일 수 없습니다."
