    "%@ I'm Pip, your travel companion. How can I help with your trip?" : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Soy Pip, tu compañero de viaje. ¿Cómo puedo ayudarte con tu viaje?"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ من پیپ هستم، همراه سفر شما. چطور می‌توانم در سفرتان کمک کنم؟"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Je suis Pip, ton compagnon de voyage. Comment puis-je t’aider pour ton voyage ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Sono Pip, il tuo compagno di viaggio. Come posso aiutarti con il viaggio?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 旅のパートナー、Pipです。旅行について何かお手伝いできますか？"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 我是 Pip，你的旅行伙伴。有什么旅行方面的问题需要我帮忙？"
          }
        }
      }
    },
