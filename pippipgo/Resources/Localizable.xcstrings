    "Live voice could not connect. Check your connection, then try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live voice could not connect. Check your connection, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo establecer la conexión de voz en directo. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اتصال صدای زنده برقرار نشد. اتصال اینترنتتان را بررسی کنید و دوباره امتحان کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de se connecter au service vocal en direct. Vérifiez votre connexion, puis réessayez."
