        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuéntame sobre un viaje, unas vacaciones o una excursión que disfrutaste mucho. ¿Qué hizo que fuera especial?"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "از سفر، تعطیلات یا حتی روزی بیرون از خانه بگو که خیلی به تو خوش گذشته. چه چیزی آن را خوب کرد؟"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raconte-moi un voyage, des vacances ou une sortie que tu as vraiment aimé. Qu’est-ce qui l’a rendu agréable ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raccontami un viaggio, una vacanza o una gita che ti è piaciuta molto. Cosa l’ha resa speciale?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "楽しかった旅行、休暇、日帰りのお出かけについて教えてください。何がよかったですか？"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "告诉我一次让你很开心的旅行、假期或一日游。是什么让它难忘？"
          }
        }
      }
    },
    "Tell me in your own words, or add a booking." : {
      "localizations" : {
