    "You are signed out locally. Cognito browser logout could not be confirmed." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تسجيل خروجك من هذا الجهاز. تعذّر التأكد من تسجيل الخروج من متصفح Cognito."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are signed out locally. Cognito browser logout could not be confirmed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has cerrado sesión localmente. No se pudo confirmar el cierre de sesión en el navegador de Cognito."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "به‌صورت محلی از حساب خارج شده‌اید. خروج از مرورگر Cognito تأیید نشد."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na-sign out ka na sa app. Hindi nakumpirma ang pag-sign out sa browser ng Cognito."
          }
        },
        "fil-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naka-sign out ka sa device na ito. Hindi nakumpirma ang pag-sign out sa Cognito browser."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes déconnecté localement. La déconnexion du navigateur Cognito n’a pas pu être confirmée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai effettuato la disconnessione locale. Non è stato possibile confermare la disconnessione dal browser Cognito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルではサインアウトしました。Cognitoのブラウザーでのログアウトを確認できませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기에서는 로그아웃되었어요. Cognito 브라우저 로그아웃 여부는 확인되지 않았어요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы вышли из аккаунта на этом устройстве. Не удалось подтвердить выход из браузера Cognito."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturumunuz yerel olarak kapatıldı. Cognito tarayıcı oturumunun kapatıldığı doğrulanamadı."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn đã đăng xuất trên thiết bị này. Không thể xác nhận việc đăng xuất khỏi trình duyệt Cognito."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已在本地退出登录。无法确认 Cognito 浏览器退出登录是否成功。"
          }
        }
      }
    },
