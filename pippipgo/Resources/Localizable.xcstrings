    "Before we plan, I'd love to get to know you a little." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Before we plan, I'd love to get to know you a little."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de planificar, me gustaría conocerte un poco."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قبل از برنامه‌ریزی، دوست دارم کمی شما را بشناسم."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avant de planifier, j’aimerais te connaître un peu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima di pianificare, vorrei conoscerti un po’."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "計画の前に、あなたのことを少し教えてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开始规划前，我想先了解你一些。"
