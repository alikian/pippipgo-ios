    "Speak naturally, taking turns. Pip translates your conversation aloud in real time." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speak naturally, taking turns. Pip translates your conversation aloud in real time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hablen con naturalidad, por turnos. Pip traduce su conversación en voz alta en tiempo real."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "به‌نوبت و طبیعی صحبت کنید. پیپ گفت‌وگوی شما را هم‌زمان با صدای بلند ترجمه می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parlez naturellement, à tour de rôle. Pip traduit votre conversation à voix haute en temps réel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parlate naturalmente, a turno. Pip traduce la conversazione ad alta voce in tempo reale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "交代で自然に話してください。Pipが会話をリアルタイムで音声翻訳します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自然地轮流说话。Pip 会实时朗读你们对话的翻译。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자연스럽게 번갈아 말해 보세요. Pip이 대화를 실시간으로 음성 번역해 드립니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy nói tự nhiên, luân phiên từng lượt. Pip sẽ dịch cuộc trò chuyện thành tiếng nói theo thời gian thực."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magsalita nang natural at magpalitan ng pagsasalita. Isinasalin ni Pip nang malakas ang usapan ninyo sa real time."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sırayla ve doğal bir şekilde konuşun. Pip, konuşmanızı gerçek zamanlı olarak sesli çevirir."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحدّث بطبيعتك مع تبادل الأدوار. يترجم Pip محادثتك بصوت عالٍ في الوقت الفعلي."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Говорите естественно, по очереди. Пип будет переводить ваш разговор вслух в реальном времени."
          }
        },
        "fil-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magsalita nang natural at salitan. Isinasalin ni Pip nang malakas ang usapan ninyo habang nag-uusap kayo."
          }
        }
      }
    },
    "Speech goes to OpenAI; profile, trips and location don’t." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speech goes to OpenAI; profile, trips and location don’t."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El audio se envía a OpenAI; tu perfil, tus viajes y tu ubicación, no."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گفتار به OpenAI فرستاده می‌شود؛ نمایه، سفرها و موقعیت مکانی‌تان نه."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La voix est envoyée à OpenAI ; votre profil, vos voyages et votre localisation ne le sont pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'audio viene inviato a OpenAI; il profilo, i viaggi e la posizione no."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声はOpenAIに送信されます。プロフィール、旅行、位置情報は送信されません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "语音会发送给 OpenAI；个人资料、行程和位置不会。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음성은 OpenAI로 전송됩니다. 프로필, 여행 정보, 위치는 전송되지 않습니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giọng nói được gửi đến OpenAI; hồ sơ, chuyến đi và vị trí thì không."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ipinapadala ang boses sa OpenAI; hindi ipinapadala ang profile, mga biyahe, at lokasyon mo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses OpenAI’a gönderilir; profil, seyahatler ve konum gönderilmez."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُرسل الصوت إلى OpenAI؛ ولا تُرسل بيانات ملفك الشخصي أو رحلاتك أو موقعك."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Речь передаётся в OpenAI; профиль, поездки и местоположение — нет."
          }
        },
        "fil-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ipinapadala ang audio sa OpenAI; hindi ipinapadala ang profile, mga biyahe at lokasyon mo."
          }
        }
      }
    },
    "Speech is shared with OpenAI to translate it while translation is on. Your profile, trips and location are not shared." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras la traducción está activa, el habla se comparte con OpenAI para traducirla. Tu perfil, viajes y ubicación no se comparten."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هنگام فعال بودن ترجمه، گفتار برای ترجمه با OpenAI به اشتراک گذاشته می‌شود. نمایه، سفرها و موقعیت شما به اشتراک گذاشته نمی‌شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant la traduction, la parole est partagée avec OpenAI pour être traduite. Ton profil, tes voyages et ta position ne sont pas partagés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
