    "Check Budget & costs: enter positive numbers or zero, with up to two decimal places (whole amounts for JPY)." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحقّق من الميزانية والتكاليف: أدخل أرقامًا موجبة أو صفرًا، مع منزلتين عشريتين كحد أقصى (مبالغ صحيحة بالين الياباني JPY)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check Budget & costs: enter positive numbers or zero, with up to two decimal places (whole amounts for JPY)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa el presupuesto y los costos: introduce números positivos o cero, con hasta dos decimales (importes enteros para JPY)."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بودجه و هزینه‌ها را بررسی کنید: عددی مثبت یا صفر وارد کنید، با حداکثر دو رقم اعشار (برای JPY، فقط مبلغ کامل)."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para sa Badyet at mga gastos, maglagay ng positibong numero o zero, na may hanggang dalawang decimal place (buong halaga para sa JPY)."
          }
        },
        "fil-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suriin ang Budget at mga gastos: maglagay ng mga positibong numero o zero, hanggang dalawang decimal place (buong halaga para sa JPY)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez le budget et les coûts : saisissez des nombres positifs ou zéro, avec au plus deux décimales (montants entiers pour le JPY)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla il budget e i costi: inserisci numeri positivi o zero, con un massimo di due cifre decimali (importi interi per JPY)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "予算と費用を確認してください：0以上の数値を入力してください。小数点以下は2桁まで（JPYは整数）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "예산 및 비용 확인: 0 또는 양수를 입력하세요. 소수점 이하 최대 두 자리까지 입력할 수 있습니다(JPY는 정수만 입력)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверьте раздел «Бюджет и расходы»: введите положительные числа или ноль, не более двух знаков после запятой (для JPY — только целые суммы)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bütçe ve masraflar bölümünde pozitif sayılar veya sıfır gir. En fazla iki ondalık basamak kullan (JPY için tam sayı gir)."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiểm tra Ngân sách & chi phí: nhập số dương hoặc số không, tối đa hai chữ số thập phân (số nguyên đối với JPY)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请检查预算和费用：输入大于零的数字或零，最多保留两位小数（日元请输入整数金额）。"
          }
        }
      }
    },
