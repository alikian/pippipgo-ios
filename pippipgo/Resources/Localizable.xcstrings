    "Deletion could not be confirmed. Your account may already be disabled. Check your connection and retry deletion." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deletion could not be confirmed. Your account may already be disabled. Check your connection and retry deletion."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo confirmar la eliminación. Es posible que tu cuenta ya esté desactivada. Comprueba tu conexión y vuelve a intentarlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حذف تأیید نشد. ممکن است حساب شما از قبل غیرفعال شده باشد. اتصال خود را بررسی کنید و دوباره برای حذف تلاش کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suppression n’a pas pu être confirmée. Votre compte est peut-être déjà désactivé. Vérifiez votre connexion et réessayez la suppression."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile confermare l’eliminazione. Il tuo account potrebbe essere già disattivato. Controlla la connessione e riprova a eliminarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削除を確認できませんでした。アカウントはすでに無効になっている可能性があります。接続を確認して、削除を再試行してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
