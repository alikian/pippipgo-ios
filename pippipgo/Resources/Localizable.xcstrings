    "That's enough to get started. I'll learn more as we go." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That's enough to get started. I'll learn more as we go."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con eso basta para empezar. Aprenderé más sobre la marcha."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای شروع کافی است. در طول راه بیشتر یاد می‌گیرم."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela suffit pour commencer. J’en apprendrai plus en chemin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basta così per iniziare. Imparerò di più strada facendo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これで始められます。旅を進めながら、もっと学んでいきます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些信息足够开始了。我会在过程中了解更多。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시작하기엔 충분해요. 함께하며 더 알아갈게요."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vậy là đủ để bắt đầu. Chúng ta sẽ tìm hiểu thêm trong lúc đi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sapat na ito para makapagsimula. Mas marami pa akong malalaman habang nagpapatuloy tayo."
