    "Totals include entered costs only. Leave unknown costs blank. Estimates and actual spending are counted separately." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los totales solo incluyen los gastos introducidos. Deja en blanco los desconocidos. Las estimaciones y los gastos reales se contabilizan por separado."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مجموع فقط شامل هزینه‌های واردشده است. هزینه‌های نامشخص را خالی بگذارید. برآوردها و مخارج واقعی جداگانه محاسبه می‌شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les totaux incluent uniquement les frais saisis. Laisse les frais inconnus vides. Les estimations et les dépenses réelles sont comptées séparément."
