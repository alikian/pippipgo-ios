          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رزرو، برنامهٔ سفر یا تصویر بفرست. پیپ جزئیات را برای بررسی پیشنهاد می‌دهد و بدون تأیید تو از آن‌ها استفاده نمی‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
