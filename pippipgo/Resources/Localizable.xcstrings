          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de planificar, me gustaría conocerte un poco."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قبل از برنامه‌ریزی، دوست دارم کمی شما را بشناسم."
