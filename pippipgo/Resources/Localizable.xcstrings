    "I'll travel with you, help when you need me, and get to know what you like along the way." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I'll travel with you, help when you need me, and get to know what you like along the way."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viajaré contigo, te ayudaré cuando lo necesites y conoceré tus gustos por el camino."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "همراهت سفر می‌کنم، هر وقت نیاز داشته باشی کمک می‌کنم و در طول راه سلیقه‌ات را می‌شناسم."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je voyagerai avec toi, t’aiderai quand tu en auras besoin et découvrirai tes goûts en chemin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viaggerò con te, ti aiuterò quando ne avrai bisogno e conoscerò i tuoi gusti lungo la strada."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旅に寄り添い、必要なときにお手伝いしながら、あなたの好みを少しずつ学びます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我会陪你旅行，在需要时提供帮助，并在途中了解你的喜好。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여행에 함께하며 필요할 때 도와드리고, 여행하는 동안 좋아하는 것도 알아갈게요."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tôi sẽ đồng hành cùng bạn, hỗ trợ khi cần và tìm hiểu sở thích của bạn trên đường đi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sasamahan kita sa biyahe, tutulong kapag kailangan mo, at aalamin ang mga gusto mo habang naglalakbay tayo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sana eşlik edeceğim, ihtiyacın olduğunda yardımcı olacak ve yol boyunca nelerden hoşlandığını öğreneceğim."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سأرافقك في رحلتك، وأساعدك عند الحاجة، وأتعرّف إلى ما تحبّه خلال الطريق."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я буду рядом в поездке, помогу, когда понадобится, и по пути узнаю, что вам нравится."
          }
        },
        "fil-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sasamahan kita sa biyahe, tutulong kapag kailangan mo, at aalamin kung ano ang gusto mo habang naglalakbay tayo."
          }
        }
      }
    },
    "I'm Pip. I'll learn what matters to you, and you can correct me anytime." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I'm Pip. I'll learn what matters to you, and you can correct me anytime."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soy Pip. Aprenderé qué te importa y puedes corregirme en cualquier momento."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من پیپ هستم. یاد می‌گیرم چه چیزهایی برایتان مهم است و هر وقت خواستید می‌توانید اصلاحم کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je suis Pip. Je découvrirai ce qui compte pour toi, et tu peux me corriger à tout moment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sono Pip. Imparerò cosa conta per te e potrai correggermi in qualsiasi momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pipです。あなたが大切にしていることを学びます。いつでも訂正してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我是 Pip。我会了解你重视的事情，你随时可以纠正我。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저는 Pip이에요. 무엇이 중요한지 알아갈게요. 언제든 제게 알려주셔도 돼요."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tôi là Pip. Tôi sẽ tìm hiểu điều gì quan trọng với bạn, và bạn có thể chỉnh lại cho tôi bất cứ lúc nào."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako si Pip. Aalamin ko kung ano ang mahalaga sa iyo, at puwede mo akong itama anumang oras."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ben Pip. Senin için nelerin önemli olduğunu öğreneceğim; istediğin zaman beni düzeltebilirsin."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنا Pip. سأتعرّف إلى ما يهمّك، ويمكنك تصحيح معلوماتي في أي وقت."
          }
        },
        "ru" : {
          "stringUnit" : {
