    "Use Google or email and password. When creating an account, enter your email address as both username and email." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Google or email and password. When creating an account, enter your email address as both username and email."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Google o correo y contraseña. Al crear una cuenta, introduce tu correo tanto como nombre de usuario como correo electrónico."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "با گوگل یا ایمیل و رمز عبور وارد شوید. هنگام ساخت حساب، نشانی ایمیل را هم در نام کاربری و هم در ایمیل وارد کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez Google ou un e-mail et un mot de passe. À la création du compte, saisissez votre e-mail comme nom d’utilisateur et comme adresse e-mail."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Google o email e password. Quando crei un account, inserisci il tuo indirizzo email sia come nome utente sia come email."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Googleまたはメールアドレスとパスワードを使用します。アカウント作成時は、ユーザー名とメールアドレスの両方にメールアドレスを入力してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 Google 或邮箱和密码。创建账户时，请在用户名和邮箱栏中都输入你的邮箱地址。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google 또는 이메일과 비밀번호를 사용하세요. 계정을 만들 때는 이메일 주소를 사용자 이름과 이메일에 모두 입력하세요."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng Google hoặc email và mật khẩu. Khi tạo tài khoản, hãy nhập địa chỉ email làm cả tên người dùng lẫn email."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gumamit ng Google o email at password. Kapag gagawa ng account, ilagay ang iyong email address bilang username at email."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google'ı veya e-posta adresinizi ve parolanızı kullanın. Hesap oluştururken e-posta adresinizi hem kullanıcı adı hem de e-posta olarak girin."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم Google أو البريد الإلكتروني وكلمة المرور. عند إنشاء حساب، أدخل عنوان بريدك الإلكتروني في حقلي اسم المستخدم والبريد الإلكتروني."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте Google или адрес электронной почты и пароль. При создании аккаунта укажите свой адрес электронной почты и в поле имени пользователя, и в поле электронной почты."
          }
        },
        "fil-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gumamit ng Google o email at password. Kapag gumagawa ng account, ilagay ang email address mo bilang username at email."
          }
        }
      }
    },
    "Use numbers with up to two decimal places, or whole yen for JPY. Negative amounts are not supported." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa números con hasta dos decimales, o yenes enteros para JPY. No se admiten importes negativos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عددها را با حداکثر دو رقم اعشار وارد کنید؛ برای ین ژاپن عدد صحیح وارد کنید. مبلغ منفی پذیرفته نمی‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise des nombres avec deux décimales au maximum, ou des yens entiers pour JPY. Les montants négatifs ne sont pas acceptés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa numeri con al massimo due decimali, oppure yen interi per JPY. Gli importi negativi non sono ammessi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小数点以下2桁までの数値を使用してください。日本円は整数で入力してください。負の金額は使用できません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请输入最多两位小数的金额，日元（JPY）须为整数。不支持负数金额。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use numbers with up to two decimal places, or whole yen for JPY. Negative amounts are not supported."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "소수점 이하 최대 두 자리까지 입력하거나, JPY의 경우 정수로 입력하세요. 음수는 지원되지 않습니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhập số có tối đa hai chữ số thập phân, hoặc số nguyên yên Nhật (JPY). Không hỗ trợ số âm."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gumamit ng mga numerong may hanggang dalawang decimal place, o mga buumbilang na yen para sa JPY. Hindi pinapayagan ang mga negatibong halaga."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En fazla iki ondalık basamak içeren sayılar veya JPY için tam sayı kullanın. Negatif tutarlar desteklenmez."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم أرقامًا بمنزلتين عشريتين كحد أقصى، أو أعدادًا صحيحة للين الياباني (JPY). لا تُقبل المبالغ السالبة."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Укажите число с двумя знаками после запятой или целое число для японских иен (JPY). Отрицательные суммы не поддерживаются."
          }
        },
        "fil-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gumamit ng mga numerong may hanggang dalawang decimal place, o buong yen para sa JPY. Hindi pinapayagan ang mga negatibong halaga."
          }
        }
      }
    },
