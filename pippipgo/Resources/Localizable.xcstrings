        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتخاب‌هایتان در جای دیگری تغییر کرده‌اند. آخرین نسخه را بارگیری و پیش از ذخیره بازبینی کنید."
