    "Pip learns the travel likes, dislikes and preferences you share to offer more personal suggestions. Review, edit or forget them here." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتعلّم Pip ما تشاركه من تفضيلات السفر وما تحبه وما لا تحبه، ليقدّم لك اقتراحات تناسبك أكثر. يمكنك مراجعتها أو تعديلها أو محوها من هنا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip learns the travel likes, dislikes and preferences you share to offer more personal suggestions. Review, edit or forget them here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip aprende tus gustos, preferencias y cosas que no te gustan al viajar para ofrecerte sugerencias más personales. Revísalos, edítalos u olvídalos aquí."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پیپ از علاقه‌ها، موارد ناخوشایند و ترجیح‌های سفری‌ای که با او در میان می‌گذارید یاد می‌گیرد تا پیشنهادهای شخصی‌تری ارائه کند. آن‌ها را اینجا مرور، ویرایش یا فراموش کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inaalam ni Pip ang mga gusto, hindi gusto, at kagustuhan mo sa paglalakbay na ibinabahagi mo para makapagbigay ng mas personal na mga mungkahi. Suriin, i-edit, o ipalimot ang mga ito rito."
          }
        },
        "fil-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inaalala ni Pip ang mga gusto, hindi gusto, at kagustuhan mo sa paglalakbay na ibinabahagi mo para makapagbigay ng mas personal na mga mungkahi. Suriin, i-edit, o ipalimot ang mga ito rito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip apprend les goûts, les préférences et les choses que vous n’aimez pas en voyage que vous partagez, afin de vous proposer des suggestions plus personnalisées. Consultez-les, modifiez-les ou oubliez-les ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip impara le preferenze di viaggio che condividi, ciò che ti piace e non ti piace, per offrirti suggerimenti più personali. Puoi rivederle, modificarle o dimenticarle qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pipは、よりあなたに合った提案をするために、共有してくれた旅行の好みや苦手なこと、希望を学習します。ここで確認、編集、削除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip은 더 개인화된 추천을 제공하기 위해 공유해 주신 여행 관련 선호와 비선호를 기억합니다. 여기에서 내용을 확인하거나 수정하거나 삭제할 수 있습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip запоминает ваши предпочтения в путешествиях — что вам нравится и не нравится, — чтобы предлагать более подходящие варианты. Здесь вы можете просмотреть, изменить или удалить эти данные."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip, daha kişisel öneriler sunmak için paylaştığınız seyahat tercihlerinizi, sevmediklerinizi ve beğenilerinizi öğrenir. Bunları burada inceleyebilir, düzenleyebilir veya unutturabilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip ghi nhớ những điều bạn chia sẻ về sở thích, điều không thích và mong muốn khi đi du lịch để đưa ra gợi ý phù hợp hơn. Bạn có thể xem lại, chỉnh sửa hoặc xóa những thông tin này tại đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip 会记住你分享的旅行喜好、厌恶和偏好，为你提供更贴合的建议。你可以在这里查看、编辑或清除这些信息。"
          }
        }
      }
    },
    "Pip mentions notable places as you walk or drive while PipPipGo is open. Your location stays on this iPhone; only the area being looked up is sent to PipPipGo." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يذكر Pip الأماكن الجديرة بالاهتمام أثناء المشي أو القيادة عندما يكون PipPipGo مفتوحًا. يبقى موقعك على هذا الـ iPhone، ولا يُرسل إلى PipPipGo سوى المنطقة التي يتم البحث عنها."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip mentions notable places as you walk or drive while PipPipGo is open. Your location stays on this iPhone; only the area being looked up is sent to PipPipGo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip menciona lugares destacados mientras caminas o conduces con PipPipGo abierta. Tu ubicación se queda en este iPhone; solo se envía a PipPipGo la zona que se consulta."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip وقتی PipPipGo باز است، هنگام پیاده‌روی یا رانندگی جاهای قابل‌توجه را معرفی می‌کند. موقعیت شما روی همین iPhone می‌ماند؛ فقط محدوده‌ای که جست‌وجو می‌شود به PipPipGo فرستاده می‌شود."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Binabanggit ni Pip ang mga kapansin-pansing lugar habang naglalakad o nagmamaneho ka at bukas ang PipPipGo. Nananatili sa iPhone na ito ang lokasyon mo; ang lugar lang na hinahanap ang ipinapadala sa PipPipGo."
          }
        },
        "fil-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Binabanggit ni Pip ang mga kapansin-pansing lugar habang naglalakad o nagmamaneho ka at bukas ang PipPipGo. Nananatili sa iPhone na ito ang lokasyon mo; ang lugar lang na hinahanap ang ipinapadala sa PipPipGo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip vous signale les lieux remarquables lorsque vous marchez ou conduisez avec PipPipGo ouvert. Votre position reste sur cet iPhone ; seule la zone recherchée est envoyée à PipPipGo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip ti segnala i luoghi degni di nota mentre cammini o guidi con PipPipGo aperta. La tua posizione resta su questo iPhone; a PipPipGo viene inviata solo la zona cercata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PipPipGoを開いている間、歩いているときや運転中に、Pipが注目スポットを紹介します。位置情報はこのiPhoneに残り、PipPipGoに送られるのは検索するエリアだけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PipPipGo가 열려 있는 동안 걷거나 운전할 때 Pip이 주목할 만한 장소를 알려 줍니다. 위치는 이 iPhone에만 남고, 조회하는 지역만 PipPipGo로 전송됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip рассказывает о примечательных местах, пока вы идёте пешком или едете, когда PipPipGo открыт. Ваше местоположение остаётся на этом iPhone; в PipPipGo отправляется только район поиска."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PipPipGo açıkken yürürken veya araç kullanırken Pip kayda değer yerlerden bahseder. Konumunuz bu iPhone’da kalır; PipPipGo’ya yalnızca aranan bölge gönderilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip giới thiệu những địa điểm đáng chú ý khi bạn đi bộ hoặc lái xe trong lúc PipPipGo đang mở. Vị trí của bạn ở lại trên iPhone này; chỉ khu vực đang tra cứu được gửi đến PipPipGo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PipPipGo 打开时，Pip 会在你步行或开车途中介绍值得一看的地方。你的位置保留在这台 iPhone 上；只有正在查询的区域会发送给 PipPipGo。"
          }
        }
      }
    },
    "Pip will welcome you back, then listen. Your current conversation appears here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيرحّب بك Pip عند عودتك، ثم ينصت إليك. ستظهر محادثتك الحالية هنا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip will welcome you back, then listen. Your current conversation appears here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip te dará la bienvenida y te escuchará. Tu conversación actual aparecerá aquí."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پیپ به شما خوشامد می‌گوید و بعد گوش می‌دهد. گفت‌وگوی فعلی‌تان اینجا نمایش داده می‌شود."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batiin ka muna ni Pip sa pagbabalik mo, saka makikinig. Lalabas dito ang kasalukuyan mong pag-uusap."
          }
        },
        "fil-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Babatihin ka ulit ni Pip, saka makikinig. Lalabas dito ang kasalukuyan mong pag-uusap."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip vous accueillera à votre retour, puis vous écoutera. Votre conversation en cours s’affichera ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip ti darà di nuovo il benvenuto, poi ti ascolterà. La conversazione in corso apparirà qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pipがまたお迎えし、あなたの話に耳を傾けます。現在の会話はここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip이 다시 오신 것을 환영한 뒤 이야기를 듣습니다. 현재 대화가 여기에 표시됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip поприветствует вас, а затем будет слушать. Здесь появится ваш текущий разговор."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip sizi yeniden karşılayıp sonra dinleyecek. Mevcut konuşmanız burada görünür."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip sẽ chào mừng bạn quay lại rồi lắng nghe. Cuộc trò chuyện hiện tại của bạn sẽ hiển thị tại đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip 会先欢迎你回来，然后倾听。你当前的对话会显示在这里。"
          }
        }
      }
    },
    "Pip, a fluffy dog, on a sunny seaside terrace" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بيب، كلب كثيف الفرو على شرفة مشمسة مطلة على البحر"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip, a fluffy dog, on a sunny seaside terrace"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip, un perro esponjoso en una terraza soleada junto al mar"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پیپ، سگی پشمالو، روی تراسی آفتابی کنار دریا"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malambot ang balahibong asong si Pip sa maaraw na terasa sa tabing-dagat"
          }
        },
        "fil-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si Pip, isang malambot na aso sa maaraw na terasa sa tabing-dagat"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip, un chien tout duveteux sur une terrasse ensoleillée au bord de la mer"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip, un cane dal pelo soffice, su una terrazza soleggiata sul mare"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "晴れた海辺のテラスにいる、ふわふわの犬のPip"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "햇살이 비치는 바닷가 테라스의 복슬복슬한 강아지 Pip"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пушистый пёс Pip на солнечной террасе у моря"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güneşli bir sahil terasında tüylü bir köpek olan Pip"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip, chú chó lông xù trên sân hiên ven biển đầy nắng"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "阳光明媚的海滨露台上，一只毛茸茸的狗狗 Pip"
          }
        }
      }
    },
    "Pip, your friendly local guide" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بيب، دليلك المحلي الودود"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip, your friendly local guide"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip, tu simpático guía local"
          }
        },
