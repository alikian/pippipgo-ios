          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your request is kept unchanged for a safe retry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu solicitud se conserva sin cambios para reintentar de forma segura."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "درخواست تو بدون تغییر برای تلاش دوباره نگه داشته شده است."
