    "Party size includes you and everyone selected below. Names are optional; selecting someone does not add to the total." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يشمل عدد أفراد المجموعة أنت وكل من تختارهم أدناه. الأسماء اختيارية؛ واختيار شخص لا يزيد العدد."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Party size includes you and everyone selected below. Names are optional; selecting someone does not add to the total."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tamaño del grupo te incluye a ti y a todos los seleccionados abajo. Los nombres son opcionales; seleccionar a alguien no aumenta el total."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعداد مسافران شامل شما و همه افراد انتخاب‌شده در زیر است. نام‌ها اختیاری هستند؛ انتخاب فرد، تعداد کل را افزایش نمی‌دهد."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kasama sa bilang ng grupo ang iyong sarili at lahat ng pipiliin mo sa ibaba. Opsyonal ang mga pangalan; hindi madadagdag sa kabuuan ang pagpili sa isang tao."
          }
        },
        "fil-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kasama sa bilang ng grupo ang iyong sarili at lahat ng napili sa ibaba. Opsyonal ang mga pangalan; walang idinadagdag sa kabuuan kapag may pinili."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La taille du groupe inclut toi et toutes les personnes sélectionnées ci-dessous. Les noms sont facultatifs ; sélectionner quelqu’un n’augmente pas le total."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il gruppo comprende te e tutte le persone selezionate sotto. I nomi sono facoltativi; selezionare qualcuno non aumenta il totale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人数にはあなたと以下で選択した全員が含まれます。名前は任意です。同行者を選択しても合計人数は増えません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인원수에는 본인과 아래에서 선택한 모든 사람이 포함됩니다. 이름은 선택 사항이며, 사람을 선택해도 총인원에는 추가되지 않습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В размер группы входите вы и все, кого вы выбрали ниже. Имена указывать необязательно; выбор человека не увеличивает общее число участников."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kişi sayısına siz ve aşağıda seçilen herkes dahildir. İsimler isteğe bağlıdır; birini seçmek toplam sayıyı artırmaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Số người gồm bạn và tất cả những người được chọn bên dưới. Không bắt buộc nhập tên; chọn một người không làm tăng tổng số."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同行人数包含你及下方选择的所有成员。姓名为选填；选择成员不会增加总人数。"
          }
        }
      }
    },
