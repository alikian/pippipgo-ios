    "I’m planning a weekend in Paris. I’d love a relaxed trip with good food." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أخطط لقضاء عطلة نهاية أسبوع في باريس. أودّ رحلة هادئة مع طعام لذيذ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I’m planning a weekend in Paris. I’d love a relaxed trip with good food."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estoy planeando un fin de semana en París. Me gustaría hacer un viaje tranquilo y disfrutar de buena comida."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دارم برای آخر هفته‌ای در پاریس برنامه‌ریزی می‌کنم. دوست دارم سفر آرامی با غذاهای خوب داشته باشم."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagpaplano ako ng weekend sa Paris. Gusto ko ng relaks na biyahe at masarap na pagkain."
          }
        },
        "fil-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagpaplano ako ng bakasyon sa Paris para sa katapusan ng linggo. Gusto ko ng relaks na biyahe at masarap na pagkain."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je prépare un week-end à Paris. J’aimerais un séjour tranquille avec de bons repas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sto organizzando un weekend a Parigi. Mi piacerebbe fare un viaggio rilassante e mangiare bene."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パリで過ごす週末を計画しています。おいしい食事を楽しみながら、ゆったり過ごしたいです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파리에서 주말을 보낼 계획이에요. 맛있는 음식을 즐기며 여유롭게 여행하고 싶어요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я планирую провести выходные в Париже. Хочется спокойной поездки и вкусной еды."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paris’te bir hafta sonu planlıyorum. Güzel yemeklerin olduğu, rahat bir gezi istiyorum."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tôi đang lên kế hoạch đi Paris vào cuối tuần. Tôi muốn có một chuyến đi thư thái với đồ ăn ngon."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
