    "Calendar access is off. You can allow it in iPhone Settings whenever you're ready." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الوصول إلى التقويمات غير مفعّل. يمكنك السماح به من إعدادات iPhone متى شئت."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calendar access is off. You can allow it in iPhone Settings whenever you're ready."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso al calendario está desactivado. Puedes permitirlo en Ajustes del iPhone cuando quieras."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دسترسی به تقویم خاموش است. هر وقت آماده بودی، می‌توانی آن را در تنظیمات iPhone فعال کنی."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naka-off ang access sa mga kalendaryo. Maaari mo itong payagan sa Settings ng iPhone anumang oras kapag handa ka na."
          }
        },
        "fil-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naka-off ang access sa mga kalendaryo. Puwede mo itong payagan sa Mga Setting ng iPhone kapag handa ka na."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès au calendrier est désactivé. Vous pourrez l’autoriser dans les Réglages de l’iPhone quand vous le souhaiterez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accesso al calendario è disattivato. Puoi consentirlo nelle Impostazioni dell’iPhone quando vuoi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カレンダーへのアクセスはオフです。準備ができたら、iPhoneの「設定」で許可できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "캘린더 접근이 꺼져 있습니다. 원할 때 언제든 iPhone 설정에서 허용할 수 있어요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ к календарю отключён. Когда будете готовы, включите его в настройках iPhone."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takvim erişimi kapalı. Hazır olduğunda iPhone Ayarları’ndan izin verebilirsin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quyền truy cập lịch đang tắt. Bạn có thể bật quyền này trong Cài đặt iPhone bất cứ khi nào sẵn sàng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日历访问权限已关闭。准备好后，你可以随时在 iPhone 设置中开启。"
          }
        }
      }
    },
