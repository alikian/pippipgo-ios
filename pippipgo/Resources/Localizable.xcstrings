        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا يكفي للبدء. سأتعرّف عليك أكثر مع مرور الوقت."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этого достаточно, чтобы начать. По ходу дела я узнаю о вас больше."
          }
