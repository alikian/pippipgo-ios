    "Your choices changed elsewhere. Load the latest and review before saving." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your choices changed elsewhere. Load the latest and review before saving."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus opciones cambiaron en otro lugar. Carga las más recientes y revísalas antes de guardar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتخاب‌هایتان در جای دیگری تغییر کرده‌اند. آخرین نسخه را بارگیری و پیش از ذخیره بازبینی کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos choix ont été modifiés ailleurs. Chargez les dernières modifications et vérifiez-les avant d’enregistrer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue scelte sono state modificate altrove. Carica quelle più recenti e rivedile prima di salvare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別の場所で選択内容が変更されました。最新の内容を読み込み、確認してから保存してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在其他地方更改了选项。请加载最新选项并检查后再保存。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 곳에서 선택 항목이 변경되었어요. 최신 내용을 불러와 검토한 후 저장해 주세요."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các lựa chọn của bạn đã thay đổi ở nơi khác. Hãy tải phiên bản mới nhất và xem lại trước khi lưu."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nabago ang mga pinili mo sa ibang lugar. I-load ang pinakabago at suriin bago i-save."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçimleriniz başka bir yerde değiştirildi. Kaydetmeden önce en güncel hâlini yükleyip gözden geçirin."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تغيير اختياراتك من مكان آخر. حمّل أحدث نسخة وراجعها قبل الحفظ."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши настройки изменились на другом устройстве. Загрузите последние изменения и проверьте их перед сохранением."
          }
        },
        "fil-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "May nagbago sa mga pinili mo sa ibang lugar. I-load ang pinakabago at suriin bago i-save."
          }
        }
      }
    },
