    "Help Pip learn how you like to travel for ideas that feel like you." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ساعد Pip على معرفة أسلوب سفرك ليقدّم لك أفكارًا تناسبك."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Help Pip learn how you like to travel for ideas that feel like you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayuda a Pip a conocer cómo te gusta viajar para darte ideas que vayan contigo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "به پیپ کمک کنید یاد بگیرد چه جور سفر کردنی را دوست دارید تا پیشنهادهایی بدهد که به شما می‌آیند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tulungan si Pip na malaman kung paano ka mahilig bumiyahe para makapagbigay siya ng mga ideyang bagay sa iyo."
          }
        },
        "fil-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tulungan si Pip na matutunan kung paano ka mahilig bumiyahe para makapagbigay siya ng mga ideyang bagay sa iyo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aidez Pip à découvrir vos préférences de voyage pour vous proposer des idées qui vous ressemblent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aiuta Pip a capire come ti piace viaggiare, per suggerirti idee che ti rispecchino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pipにあなたの旅の好みを知ってもらい、あなたらしいアイデアを提案してもらいましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip이 여행 취향을 알면 나에게 꼭 맞는 아이디어를 제안할 수 있어요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Помогите Pip узнать, как вам нравится путешествовать, чтобы идеи были вам по душе."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip'in sana uygun fikirler sunabilmesi için nasıl seyahat etmeyi sevdiğini öğrenmesine yardımcı ol."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giúp Pip hiểu cách bạn thích đi du lịch để gợi ý phù hợp với bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "告诉 Pip 你的旅行偏好，让推荐更符合你的喜好。"
          }
        }
      }
    },
    "Help Pip learn how you like to travel, so ideas for destinations, local gems and activities feel more like you. Share in your own words, or skip anything." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ساعد Pip على معرفة أسلوب سفرك، ليقدّم لك أفكارًا عن وجهات وأماكن محلية مميزة وأنشطة تناسبك أكثر. شارك ما تريد بكلماتك، أو تخطَّ أي شيء."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Help Pip learn how you like to travel, so ideas for destinations, local gems and activities feel more like you. Share in your own words, or skip anything."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayuda a Pip a conocer cómo te gusta viajar, para que las ideas de destinos, lugares especiales y actividades se adapten más a ti. Cuéntalo con tus propias palabras o sáltate lo que quieras."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "به پیپ کمک کنید یاد بگیرد چه جور سفر کردنی را دوست دارید تا پیشنهادهای مقصد، دیدنی‌های محلی و فعالیت‌ها بیشتر به سلیقه‌تان بخورند. با بیان خودتان بگویید، یا از هر موردی که خواستید بگذرید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tulungan si Pip na malaman kung paano ka mahilig bumiyahe, para mas bagay sa iyo ang mga ideya tungkol sa mga destinasyon, mga natatagong lokal na paborito, at mga aktibidad. Ibahagi sa sarili mong pananalita o laktawan ang anumang tanong."
          }
        },
        "fil-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tulungan si Pip na matutunan kung paano ka mahilig bumiyahe para mas bumagay sa iyo ang mga ideya niya tungkol sa mga destinasyon, tagong yaman ng mga lokal at aktibidad. Ikuwento ito sa sarili mong mga salita, o laktawan ang anumang ayaw mong sagutin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aidez Pip à découvrir vos préférences de voyage pour vous proposer des destinations, des pépites locales et des activités qui vous ressemblent. Répondez avec vos propres mots ou passez les questions qui ne vous intéressent pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aiuta Pip a capire come ti piace viaggiare, così le idee su destinazioni, luoghi nascosti e attività ti rispecchieranno di più. Raccontalo con parole tue o salta ciò che vuoi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pipにあなたの旅の好みを知ってもらい、目的地や地元の穴場、アクティビティについて、あなたらしいアイデアを提案してもらいましょう。自由に入力するか、答えたくない項目はスキップしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip이 여행 취향을 알면 여행지, 현지 명소, 활동을 더 취향에 맞게 추천할 수 있어요. 편하게 이야기해 주세요. 건너뛰고 싶은 항목은 건너뛰어도 돼요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Помогите Pip узнать, как вам нравится путешествовать, чтобы идеи о направлениях, местных секретах и занятиях были вам по душе. Расскажите своими словами или пропустите любой вопрос."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip'in sana daha uygun destinasyon, yerel keşif ve etkinlik fikirleri sunabilmesi için nasıl seyahat etmeyi sevdiğini öğrenmesine yardımcı ol. Kendi sözlerinle anlatabilir veya istediğin soruyu atlayabilirsin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giúp Pip hiểu cách bạn thích đi du lịch để gợi ý điểm đến, địa điểm thú vị và hoạt động phù hợp hơn với bạn. Hãy chia sẻ theo cách của bạn hoặc bỏ qua bất kỳ mục nào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "告诉 Pip 你的旅行偏好，让目的地、当地好去处和活动推荐更符合你的喜好。你可以用自己的话分享，也可以跳过任何问题。"
          }
        }
      }
    },
