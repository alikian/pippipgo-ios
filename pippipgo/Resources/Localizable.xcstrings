    "Tell me about a trip or day out you really enjoyed. What made it good?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tell me about a trip or day out you really enjoyed. What made it good?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuéntame sobre un viaje o una excursión que disfrutaste mucho. ¿Qué hizo que fuera especial?"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "از سفر یا روزی بگویید که واقعاً لذت بردید. چه چیزی آن را خوب کرد؟"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raconte-moi un voyage ou une sortie que tu as vraiment aimé. Qu’est-ce qui l’a rendu agréable ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raccontami un viaggio o una gita che ti è piaciuta molto. Cosa l’ha resa speciale?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "楽しかった旅行やお出かけについて教えてください。何がよかったですか？"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "告诉我一次让你很开心的旅行或出游。是什么让它难忘？"
          }
        }
      }
    },
    "Tell me about a trip, vacation, or even a day out that you really enjoyed. What made it good?" : {
