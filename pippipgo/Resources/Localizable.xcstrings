    "Check the party size: use 1–30 travelers, with enough places for everyone selected." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check the party size: use 1–30 travelers, with enough places for everyone selected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa el tamaño del grupo: indica de 1 a 30 viajeros y selecciona suficientes plazas para todos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعداد افراد گروه را بررسی کنید: بین ۱ تا ۳۰ مسافر وارد کنید و برای همهٔ افراد، به‌اندازهٔ کافی جا انتخاب کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez la taille du groupe : indiquez entre 1 et 30 voyageurs et sélectionnez suffisamment de places pour tout le monde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla il numero di partecipanti: indica da 1 a 30 viaggiatori e assicurati che ci siano abbastanza posti per tutti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人数を確認してください：旅行者は1～30人にし、選択した全員分の場所を確保してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请检查出行人数：选择 1–30 位旅行者，并确保所选地点能容纳所有人。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여행 인원을 확인하세요. 여행자는 1~30명이어야 하며, 선택한 모든 여행자가 이용할 수 있는 자리가 있어야 합니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiểm tra số người: chọn từ 1–30 khách và đủ chỗ cho tất cả mọi người đã chọn."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tingnan ang dami ng kasama: dapat 1–30 ang biyahero at may sapat na lugar para sa lahat ng napili."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grup büyüklüğünü kontrol edin: 1–30 yolcu seçin ve herkes için yeterli yer olduğundan emin olun."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحقق من عدد أفراد المجموعة: اختر من 1 إلى 30 مسافرًا، وتأكد من توفر أماكن كافية للجميع."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверьте количество участников: от 1 до 30 человек, мест должно хватить всем выбранным участникам."
          }
        },
        "fil-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tingnan ang dami ng kasama: gumamit ng 1–30 biyahero at tiyaking may sapat na lugar para sa lahat ng napili."
          }
        }
      }
    },
