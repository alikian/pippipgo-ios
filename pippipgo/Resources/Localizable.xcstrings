    "Suggested dates are a starting point, not a holiday assumption. Adjust them before confirming." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التواريخ المقترحة نقطة بداية، ولا تعني افتراض أنك في عطلة. عدّلها قبل التأكيد."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggested dates are a starting point, not a holiday assumption. Adjust them before confirming."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fechas sugeridas son un punto de partida, no una suposición sobre festivos. Ajústalas antes de confirmar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این تاریخ‌ها فقط پیشنهاد اولیه‌اند، نه فرض تعطیلی. پیش از تأیید آن‌ها را تنظیم کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panimulang mungkahi lang ang mga iminumungkahing petsa; hindi ito nangangahulugang holiday ang biyahe. Baguhin ang mga ito bago kumpirmahin."
          }
        },
        "fil-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panimulang mungkahi lang ang mga petsang ito, hindi palagay na magbabakasyon ka. Baguhin ang mga ito bago kumpirmahin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dates suggérées sont un point de départ, pas une hypothèse sur les jours fériés. Ajuste-les avant de confirmer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le date suggerite sono un punto di partenza, non un’ipotesi sulle festività. Modificale prima di confermare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提案された日付は出発点であり、祝日を想定したものではありません。確定する前に調整してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "추천 날짜는 시작점일 뿐, 휴일이라고 가정한 것이 아닙니다. 확정하기 전에 날짜를 조정하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предложенные даты — лишь отправная точка, а не предположение о поездке на праздники. Измените их перед подтверждением."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önerilen tarihler bir başlangıç noktasıdır; tatil varsayımı değildir. Onaylamadan önce tarihleri düzenleyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngày được gợi ý chỉ là điểm khởi đầu, không có nghĩa là bạn sẽ đi nghỉ lễ. Hãy điều chỉnh trước khi xác nhận."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "建议日期只是起点，并非对假期的假设。确认前请调整。"
          }
        }
      }
    },
    "Suggestions are not bookings. Live hours, weather and availability have not been verified." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه الاقتراحات ليست حجوزات. لم يتم التحقق من ساعات العمل أو الطقس أو التوافر الحالي."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggestions are not bookings. Live hours, weather and availability have not been verified."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las sugerencias no son reservas. No se han comprobado horarios, tiempo ni disponibilidad actuales."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پیشنهادها رزرو نیستند. ساعت کاری، آب‌وهوا و ظرفیت فعلی بررسی نشده‌اند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi pa mga booking ang mga mungkahi. Hindi pa nabeberipika ang kasalukuyang oras ng operasyon, lagay ng panahon at availability."
          }
        },
        "fil-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi ito mga booking. Hindi pa nasusuri ang kasalukuyang oras ng operasyon, lagay ng panahon, at availability."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les suggestions ne sont pas des réservations. Les horaires, la météo et les disponibilités actuels n’ont pas été vérifiés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I suggerimenti non sono prenotazioni. Orari, meteo e disponibilità attuali non sono stati verificati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提案は予約ではありません。最新の営業時間、天気、空き状況は確認されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "추천 정보는 예약이 아닙니다. 실시간 운영 시간, 날씨 및 예약 가능 여부는 확인되지 않았습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предложения — это не бронирования. Актуальные часы работы, погода и наличие мест не проверены."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öneriler rezervasyon değildir. Güncel çalışma saatleri, hava durumu ve müsaitlik doğrulanmamıştır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gợi ý không phải là đặt chỗ. Giờ hoạt động, thời tiết và tình trạng chỗ trống chưa được xác minh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "建议不等于预订。实时营业时间、天气和可用情况尚未核实。"
          }
        }
      }
    },
