    "Your edit has not overwritten the saved version. Reload the latest version to review and edit it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُستبدل الإصدار المحفوظ بتعديلاتك. أعد تحميل أحدث إصدار لمراجعته وتعديله."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your edit has not overwritten the saved version. Reload the latest version to review and edit it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu edición no ha sobrescrito la versión guardada. Vuelve a cargar la última versión para revisarla y editarla."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ویرایش شما جایگزین نسخه ذخیره‌شده نشده است. آخرین نسخه را دوباره بارگیری کنید تا آن را بررسی و ویرایش کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi napalitan ng mga pag-edit mo ang naka-save na bersyon. I-reload ang pinakabagong bersyon para suriin at i-edit ito."
          }
        },
        "fil-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi napalitan ng mga pagbabago mo ang naka-save na bersyon. I-reload ang pinakabagong bersyon para suriin at i-edit ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta modification n’a pas remplacé la version enregistrée. Recharge la dernière version pour la vérifier et la modifier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua modifica non ha sovrascritto la versione salvata. Ricarica l’ultima versione per controllarla e modificarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "編集内容は保存済みの版を上書きしていません。最新版を再読み込みして確認・編集してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수정 내용이 저장된 버전에 반영되지 않았습니다. 최신 버전을 불러와 검토하고 수정하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши изменения не заменили сохранённую версию. Загрузите последнюю версию, чтобы просмотреть и отредактировать её."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düzenlemen kayıtlı sürümün üzerine yazılmadı. İncelemek ve düzenlemek için en son sürümü yeniden yükle."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản chỉnh sửa của bạn chưa ghi đè lên phiên bản đã lưu. Tải lại phiên bản mới nhất để xem và chỉnh sửa."
