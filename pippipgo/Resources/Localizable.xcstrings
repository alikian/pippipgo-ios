    "Consider rideshare, a drop-off, parking, shuttle, transit, taxi or rental car. Pickup points and travel times need checking for your actual airport." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Considera un coche con conductor, que te lleven, aparcamiento, lanzadera, transporte público, taxi o coche de alquiler. Comprueba los puntos de recogida y los tiempos de viaje de tu aeropuerto."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خودروی اشتراکی، رساندن با خودرو، پارکینگ، شاتل، حمل‌ونقل عمومی، تاکسی یا خودروی اجاره‌ای را بررسی کنید. محل سوار شدن و زمان مسیر را برای فرودگاه خود بررسی کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envisage une voiture avec chauffeur, une dépose, un parking, une navette, les transports en commun, un taxi ou une voiture de location. Vérifie les points de prise en charge et les temps de trajet pour ton aéroport."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valuta un’auto con conducente, un passaggio, parcheggio, navetta, mezzi pubblici, taxi o auto a noleggio. Verifica punti di prelievo e tempi di percorrenza per il tuo aeroporto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配車サービス、送迎、駐車場、シャトル、公共交通、タクシー、レンタカーなどを検討してください。利用する空港の乗車場所と所要時間を確認する必要があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可考虑网约车、接送、停车、班车、公共交通、出租车或租车。请核实实际机场的上车点和路程时间。"
          }
        }
      }
    },
