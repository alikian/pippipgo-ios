    "%@ I'm Pip, your travel companion. How can I help with your trip?" : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Soy Pip, tu compañero de viaje. ¿Cómo puedo ayudarte con tu viaje?"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ من پیپ هستم، همراه سفر شما. چطور می‌توانم در سفرتان کمک کنم؟"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Je suis Pip, ton compagnon de voyage. Comment puis-je t’aider pour ton voyage ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Sono Pip, il tuo compagno di viaggio. Come posso aiutarti con il viaggio?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 旅のパートナー、Pipです。旅行について何かお手伝いできますか？"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 我是 Pip，你的旅行伙伴。有什么旅行方面的问题需要我帮忙？"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ I'm Pip, your travel companion. How can I help with your trip?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 안녕하세요, 여행 동반자 Pip이에요. 여행에 대해 무엇을 도와드릴까요?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Mình là Pip, người bạn đồng hành trong chuyến đi. Mình có thể giúp gì cho chuyến đi của bạn?"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Ako si Pip, kasama mo sa biyahe. Paano kita matutulungan sa biyahe mo?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Ben Pip, seyahat arkadaşınım. Seyahatinle ilgili nasıl yardımcı olabilirim?"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ أنا Pip، رفيقك في السفر. كيف يمكنني مساعدتك في رحلتك؟"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Я Пип, ваш спутник в путешествиях. Чем помочь с поездкой?"
          }
        },
        "fil-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Ako si Pip, kasama mo sa paglalakbay. Paano ako makakatulong sa biyahe mo?"
          }
        }
      }
    },
