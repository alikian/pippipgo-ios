    "Pip couldn't find booking details. You can add them yourself or choose another receipt." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip couldn't find booking details. You can add them yourself or choose another receipt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip no encontró los datos de la reserva. Puedes agregarlos tú o elegir otro recibo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip نتوانست جزئیات رزرو را پیدا کند. می‌توانی خودت آن‌ها را اضافه کنی یا رسید دیگری انتخاب کنی."
