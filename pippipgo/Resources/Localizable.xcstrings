        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ những điều quan trọng cho chuyến đi này. Bạn có thể bổ sung sau."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
