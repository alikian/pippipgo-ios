    "Totals include entered costs only. Leave unknown costs blank. Estimates and actual spending are counted separately." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تشمل الإجماليات التكاليف المُدخلة فقط. اترك التكاليف غير المعروفة فارغة. تُحتسب التقديرات والمصروفات الفعلية كلٌّ على حدة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Totals include entered costs only. Leave unknown costs blank. Estimates and actual spending are counted separately."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los totales solo incluyen los gastos introducidos. Deja en blanco los desconocidos. Las estimaciones y los gastos reales se contabilizan por separado."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مجموع فقط شامل هزینه‌های واردشده است. هزینه‌های نامشخص را خالی بگذارید. برآوردها و مخارج واقعی جداگانه محاسبه می‌شوند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mga inilagay na gastos lang ang kasama sa mga kabuuan. Iwang blangko ang mga hindi alam na gastos. Magkahiwalay na binibilang ang mga pagtatantya at aktuwal na nagastos."
          }
        },
        "fil-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mga naipasok na gastos lang ang kasama sa mga kabuuan. Iwanang blangko ang mga hindi alam na gastos. Hiwalay ang bilang ng mga tantiya at aktuwal na nagastos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les totaux incluent uniquement les frais saisis. Laisse les frais inconnus vides. Les estimations et les dépenses réelles sont comptées séparément."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I totali includono solo le spese inserite. Lascia vuote quelle sconosciute. Stime e spese effettive vengono conteggiate separatamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "合計には入力済みの費用のみ含まれます。不明な費用は空欄にしてください。見積もりと実際の支出は別々に集計します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "합계에는 입력한 비용만 포함됩니다. 모르는 비용은 비워 두세요. 예상 지출과 실제 지출은 별도로 집계됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В итог входят только внесённые расходы. Неизвестные расходы оставьте пустыми. Оценочные и фактические расходы учитываются отдельно."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toplamlara yalnızca girilen masraflar dâhildir. Bilinmeyen masrafları boş bırakın. Tahminler ve gerçekleşen harcamalar ayrı ayrı hesaplanır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tổng chi phí chỉ bao gồm các khoản đã nhập. Để trống những khoản chưa biết. Chi phí ước tính và chi tiêu thực tế được tính riêng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "总计仅包含已填写的费用。未知费用请留空。预估费用和实际支出分别计算。"
          }
        }
      }
    },
