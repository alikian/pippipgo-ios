    "Send a booking, itinerary, or screenshot. Pip proposes details for you to review before anything is used in your plan." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أرسل حجزًا أو خط سير أو لقطة شاشة. يقترح Pip تفاصيل لتراجعها قبل إضافتها إلى خطتك."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send a booking, itinerary, or screenshot. Pip proposes details for you to review before anything is used in your plan."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía una reserva, itinerario o captura. Pip propone detalles para que los revises antes de incorporarlos a tu plan."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رزرو، برنامهٔ سفر یا تصویر بفرست. پیپ جزئیات را برای بررسی پیشنهاد می‌دهد و بدون تأیید تو از آن‌ها استفاده نمی‌کند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magpadala ng booking, itinerary, o screenshot. Magmumungkahi si Pip ng mga detalye na susuriin mo bago isama ang anuman sa plano mo."
          }
        },
        "fil-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magpadala ng booking, itinerary o screenshot. Magmumungkahi si Pip ng mga detalye para masuri mo bago isama ang anuman sa plano mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoie une réservation, un itinéraire ou une capture d’écran. Pip propose des détails à vérifier avant de les utiliser dans ton programme."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invia una prenotazione, un itinerario o uno screenshot. Pip propone dettagli da controllare prima di usarli nel piano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "予約、旅程、スクリーンショットを送信してください。プランに反映する前に、Pipが確認用の詳細を提案します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "예약 정보, 일정 또는 스크린샷을 보내세요. Pip이 세부 정보를 제안하면 일정에 반영하기 전에 확인할 수 있습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправьте бронирование, маршрут или снимок экрана. Пип предложит детали — проверьте их, прежде чем добавлять в план."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir rezervasyon, seyahat programı veya ekran görüntüsü gönderin. Pip, planınızda kullanılmadan önce gözden geçirmeniz için ayrıntı önerir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gửi thông tin đặt chỗ, lịch trình hoặc ảnh chụp màn hình. Pip sẽ đề xuất thông tin để bạn xem lại trước khi đưa bất cứ nội dung nào vào kế hoạch."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发送预订、行程或截图。Pip 会先提出详情供你审核，之后才用于计划。"
          }
        }
      }
    },
