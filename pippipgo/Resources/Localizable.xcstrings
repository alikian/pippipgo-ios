    "Changing language keeps your trips and memories." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changing language keeps your trips and memories."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambiar el idioma conserva tus viajes y recuerdos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "با تغییر زبان، سفرها و خاطره‌هایت حفظ می‌شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changer de langue conserve tes voyages et tes souvenirs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambiare lingua conserva i tuoi viaggi e ricordi."
