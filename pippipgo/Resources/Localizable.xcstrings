    "Tell me about a trip or day out you really enjoyed. What made it good?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أخبرني عن رحلة أو نزهة استمتعت بها فعلًا. ما الذي جعلها رائعة؟"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tell me about a trip or day out you really enjoyed. What made it good?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuéntame sobre un viaje o una excursión que disfrutaste mucho. ¿Qué hizo que fuera especial?"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "از سفر یا روزی بگویید که واقعاً لذت بردید. چه چیزی آن را خوب کرد؟"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikuwento sa akin ang isang biyahe o pamamasyal na talagang nagustuhan mo. Ano ang nagpasaya rito?"
          }
        },
        "fil-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikuwento mo sa akin ang isang biyahe o pamamasyal na talagang nagustuhan mo. Ano ang nagpasaya rito?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raconte-moi un voyage ou une sortie que tu as vraiment aimé. Qu’est-ce qui l’a rendu agréable ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raccontami un viaggio o una gita che ti è piaciuta molto. Cosa l’ha resa speciale?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "楽しかった旅行やお出かけについて教えてください。何がよかったですか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정말 즐거웠던 여행이나 나들이에 대해 이야기해 주세요. 무엇이 좋았나요?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расскажите о поездке или прогулке, которая вам очень понравилась. Что сделало её такой удачной?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerçekten keyif aldığınız bir geziyi veya günü anlatın. Onu güzel yapan neydi?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kể tôi nghe về một chuyến đi hoặc buổi đi chơi mà bạn thực sự thích. Điều gì khiến chuyến đi đó thú vị?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "告诉我一次让你很开心的旅行或出游。是什么让它难忘？"
          }
        }
      }
    },
