    "A little less planning.\nA little more exploring." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A little less planning.\nA little more exploring."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برنامه‌ریزی کمتر.\nکشف و تجربه بیشتر."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un poco menos de planificación.\nUn poco más de exploración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un peu moins de planification.\nUn peu plus de découverte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meno pianificazione.\nPiù esplorazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "計画は少し控えめに。\n旅をもっと楽しみましょう。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "少一点规划。\n多一点探索。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계획은 조금 덜,\n탐험은 조금 더."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bớt lên kế hoạch một chút.\nKhám phá nhiều hơn một chút."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bawas-bawasan ang pagpaplano.\nMas maglaan ng oras sa pamamasyal."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biraz daha az planlama.\nBiraz daha çok keşif."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تخطيط أقل.\nواستكشاف أكثر."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чуть меньше планов.\nЧуть больше открытий."
          }
        },
        "fil-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaunting pagpaplano.\nMas maraming pagtuklas."
          }
        }
      }
    },
    "A recap of what we discussed, not live availability or confirmed bookings." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A recap of what we discussed, not live availability or confirmed bookings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un resumen de lo que hablamos, no de la disponibilidad en tiempo real ni de reservas confirmadas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خلاصه‌ای از گفت‌وگوی ما، نه موجودیِ لحظه‌ای یا رزروهای تأییدشده."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un récapitulatif de ce dont nous avons parlé, sans disponibilité en temps réel ni réservations confirmées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un riepilogo di ciò di cui abbiamo parlato, non della disponibilità in tempo reale né di prenotazioni confermate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "話し合った内容のまとめです。空き状況や予約の確定を示すものではありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是我们讨论内容的回顾，不代表实时空位或已确认的预订。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "함께 나눈 내용의 요약이며, 실시간 예약 가능 여부나 확정된 예약 정보는 아닙니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tóm tắt những gì chúng ta đã trao đổi, không phải tình trạng còn chỗ hiện tại hay đặt chỗ đã xác nhận."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buod ito ng napag-usapan natin, hindi ng kasalukuyang availability o kumpirmadong booking."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Görüştüklerimizin özeti; güncel müsaitlik veya onaylanmış rezervasyon bilgisi değildir."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملخص لما ناقشناه، وليس معلومات مباشرة عن التوفر أو حجوزات مؤكدة."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
