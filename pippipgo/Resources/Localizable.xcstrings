          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise Plans d’Apple sur votre iPhone. Rien ici n’est envoyé à PipPipGo."
          }
        },
        "it" : {
          "stringUnit" : {
