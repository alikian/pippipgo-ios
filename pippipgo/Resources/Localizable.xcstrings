    "Review every flight. Direction and segment order replace any saved flight with the same direction/order. Other bookings remain unchanged." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa cada vuelo. La dirección y el orden del tramo sustituyen cualquier vuelo guardado con esa misma dirección y orden. Las demás reservas no cambian."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "همه پروازها را بررسی کنید. پرواز با همان جهت و ترتیب بخش، جایگزین پرواز ذخیره‌شده می‌شود. سایر رزروها تغییر نمی‌کنند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifie chaque vol. Le sens et l’ordre des segments remplacent tout vol enregistré avec le même sens et ordre. Les autres réservations restent inchangées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla ogni volo. Direzione e ordine del segmento sostituiscono qualsiasi volo salvato con la stessa direzione e ordine. Le altre prenotazioni restano invariate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての航空便を確認してください。同じ方向と区間順序の保存済み航空便は置き換えられます。他の予約は変更されません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请查看每个航班。方向和航段顺序相同的已保存航班将被替换。其他预订保持不变。"
          }
        }
      }
    },
    "Review extracted details" : {
