    "Tell Pip a little, add a booking, or choose Nothing yet." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أخبر Pip قليلًا عن خطتك، أو أضف حجزًا، أو اختر «لا شيء بعد»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tell Pip a little, add a booking, or choose Nothing yet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuéntale un poco a Pip, añade una reserva o elige «Todavía nada»."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کمی برای Pip توضیح دهید، جزئیات رزرو را اضافه کنید یا «هنوز چیزی ندارم» را انتخاب کنید."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magkuwento nang kaunti kay Pip, magdagdag ng booking, o piliin ang Wala pa."
          }
        },
        "fil-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magkuwento nang kaunti kay Pip, magdagdag ng booking, o piliin ang Wala pa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dites quelques mots à Pip, ajoutez une réservation ou choisissez « Pas encore »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Racconta qualcosa a Pip, aggiungi una prenotazione oppure scegli «Non ancora»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pipに少し伝えるか、予約を追加するか、「まだ何もありません」を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip에게 여행 정보를 조금 알려주거나, 예약을 추가하거나, 아직 정해진 것이 없음을 선택하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расскажите Пип немного о себе, добавьте бронирование или выберите «Пока ничего»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pip'e biraz bilgi ver, rezervasyon ekle veya Şimdilik hiçbir şey'i seç."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kể Pip nghe một chút, thêm thông tin đặt chỗ hoặc chọn Chưa có gì."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "告诉 Pip 一些信息、添加预订，或选择“还没有”。"
          }
        }
      }
    },
