        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ожидание новых данных о местоположении. Повторная попытка будет выполнена автоматически."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni bir konum bekleniyor. Otomatik olarak yeniden denenecek."
