    "Hi there! I’m Pip, your friendly local guide. What would make today a good day for you?" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hi there! I’m Pip, your friendly local guide. What would make today a good day for you?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Hola! Soy Pip, tu simpático guía local. ¿Qué haría que hoy fuera un buen día para ti?"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سلام! من Pip هستم، راهنمای محلیِ خوش‌برخورد شما. چه چیزی امروز را برایتان به روز خوبی تبدیل می‌کند؟"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bonjour ! Je suis Pip, votre guide local sympa. Qu’est-ce qui rendrait votre journée agréable ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciao! Sono Pip, la tua guida locale. Cosa renderebbe speciale la tua giornata di oggi?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "こんにちは！地元に詳しいガイドのPipです。今日はどんな一日になるとうれしいですか？"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你好！我是 Pip，你友好的本地向导。今天怎样安排会让你开心呢？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "안녕하세요! 저는 친근한 현지 가이드 Pip이에요. 오늘 어떤 하루를 보내고 싶으세요?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chào bạn! Mình là Pip, hướng dẫn viên địa phương thân thiện của bạn. Điều gì sẽ khiến hôm nay trở thành một ngày tuyệt vời với bạn?"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kumusta! Ako si Pip, ang palakaibigan mong lokal na gabay. Ano ang makapagpapasaya sa araw mo ngayon?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merhaba! Ben Pip, samimi yerel rehberiniz. Bugününüzü güzelleştirecek şey ne olur?"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أهلًا! أنا Pip، دليلك المحلي الودود. ما الذي يجعل يومك يومًا رائعًا؟"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Привет! Я Пип, ваш дружелюбный местный гид. Что сделало бы сегодняшний день удачным для вас?"
          }
        },
        "fil-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kumusta! Ako si Pip, ang palakaibigan mong lokal na gabay. Ano ang makapagpapaganda ng araw mo ngayon?"
          }
        }
      }
    },
