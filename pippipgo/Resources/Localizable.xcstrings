    "Only what matters for this trip. You can add more later." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only what matters for this trip. You can add more later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo lo importante para este viaje. Puedes añadir más después."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فقط آنچه برای این سفر مهم است. بعداً هم می‌توانی جزئیات اضافه کنی."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seulement ce qui compte pour ce voyage. Tu pourras en ajouter plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo ciò che conta per questo viaggio. Potrai aggiungere altro dopo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この旅で大切なことだけで大丈夫です。あとから追加できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只需填写本次旅行的重要信息，以后还可以补充。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이번 여행에 필요한 내용만 알려 주세요. 나중에 더 추가할 수 있어요."
