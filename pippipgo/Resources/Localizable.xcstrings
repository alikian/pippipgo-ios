          "stringUnit" : {
            "state" : "translated",
            "value" : "سيُطبّق اختيارك للصوت في المرة القادمة التي تفتح فيها الصوت."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your voice choice takes effect the next time you open voice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu elección de voz se aplicará la próxima vez que abras la función de voz."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتخاب صدای شما از دفعهٔ بعدی که حالت صوتی را باز کنید اعمال می‌شود."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa susunod na buksan mo ang voice, gagana na ang pinili mong boses."
