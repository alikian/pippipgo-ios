    "I'll travel with you, help when you need me, and get to know what you like along the way." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سأرافقك في رحلتك، وأساعدك عند الحاجة، وأتعرّف إلى ما تحبّه خلال الطريق."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I'll travel with you, help when you need me, and get to know what you like along the way."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viajaré contigo, te ayudaré cuando lo necesites y conoceré tus gustos por el camino."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "همراهت سفر می‌کنم، هر وقت نیاز داشته باشی کمک می‌کنم و در طول راه سلیقه‌ات را می‌شناسم."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sasamahan kita sa biyahe, tutulong kapag kailangan mo, at aalamin ang mga gusto mo habang naglalakbay tayo."
          }
        },
        "fil-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sasamahan kita sa biyahe, tutulong kapag kailangan mo, at aalamin kung ano ang gusto mo habang naglalakbay tayo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je voyagerai avec toi, t’aiderai quand tu en auras besoin et découvrirai tes goûts en chemin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viaggerò con te, ti aiuterò quando ne avrai bisogno e conoscerò i tuoi gusti lungo la strada."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旅に寄り添い、必要なときにお手伝いしながら、あなたの好みを少しずつ学びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여행에 함께하며 필요할 때 도와드리고, 여행하는 동안 좋아하는 것도 알아갈게요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я буду рядом в поездке, помогу, когда понадобится, и по пути узнаю, что вам нравится."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sana eşlik edeceğim, ihtiyacın olduğunda yardımcı olacak ve yol boyunca nelerden hoşlandığını öğreneceğim."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tôi sẽ đồng hành cùng bạn, hỗ trợ khi cần và tìm hiểu sở thích của bạn trên đường đi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我会陪你旅行，在需要时提供帮助，并在途中了解你的喜好。"
          }
        }
      }
    },
    "I’m looking around. I’ll tell you when we pass something interesting." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنظر حولك الآن. سأخبرك عندما نمرّ بشيء مثير للاهتمام."
          }
        },
        "en" : {
