    "We can move on to your trip whenever you're ready." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكننا الانتقال إلى رحلتك متى كنت مستعدًا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We can move on to your trip whenever you're ready."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando quieras, podemos pasar a organizar tu viaje."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هر وقت آماده بودید، می‌توانیم سراغ سفرتان برویم."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maaari na tayong magpatuloy sa biyahe mo kapag handa ka na."
          }
        },
        "fil-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maaari na tayong magpatuloy sa biyahe mo kapag handa ka na."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On pourra passer à votre voyage dès que vous serez prêt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando vuoi, possiamo passare al tuo viaggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "準備ができたら、旅の計画に進みましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "준비되면 여행 이야기로 넘어가도 좋아요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда будете готовы, можем перейти к планированию поездки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hazır olduğunuzda seyahatinize geçebiliriz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi nào sẵn sàng, chúng ta có thể bắt đầu chuyến đi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "准备好后，我们就可以开始规划你的旅程。"
          }
        }
      }
    },
