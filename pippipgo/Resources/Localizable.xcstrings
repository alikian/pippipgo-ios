    "Before we plan, I'd love to get to know you a little." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قبل أن نخطط، أود أن أتعرف عليك قليلًا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Before we plan, I'd love to get to know you a little."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de planificar, me gustaría conocerte un poco."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قبل از برنامه‌ریزی، دوست دارم کمی شما را بشناسم."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bago tayo magplano, gusto muna kitang makilala nang kaunti."
          }
        },
        "fil-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bago tayo magplano, gusto muna kitang makilala nang kaunti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avant de planifier, j’aimerais te connaître un peu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima di pianificare, vorrei conoscerti un po’."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "計画の前に、あなたのことを少し教えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계획을 세우기 전에, 당신에 대해 조금 알고 싶어요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прежде чем планировать, мне хотелось бы немного узнать вас."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan yapmadan önce sizi biraz tanımak isterim."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trước khi lên kế hoạch, Pip muốn tìm hiểu đôi chút về bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开始规划前，我想先了解你一些。"
          }
        }
      }
    },
