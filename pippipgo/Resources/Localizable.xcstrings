    "Add a trip yourself, or ask Pip to plan one with you." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade un viaje tú mismo o pídele a Pip que planifique uno contigo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خودتان سفری اضافه کنید یا از پیپ بخواهید با شما برنامه‌ریزی کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez un voyage vous-même ou demandez à Pip d’en planifier un avec vous."
