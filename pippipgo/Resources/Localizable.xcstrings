    "All costs use this currency. Changing it does not convert amounts." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los gastos usan esta moneda. Cambiarla no convierte los importes."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "همه هزینه‌ها با این ارز ثبت می‌شوند. تغییر ارز، مبلغ‌ها را تبدیل نمی‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les frais utilisent cette devise. La modifier ne convertit pas les montants."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutte le spese usano questa valuta. Cambiarla non converte gli importi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての費用にこの通貨を使用します。通貨を変更しても金額は換算されません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有费用均使用此货币。更改货币不会换算金额。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All costs use this currency. Changing it does not convert amounts."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 비용은 이 통화로 표시됩니다. 통화를 변경해도 금액은 환산되지 않습니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tất cả chi phí đều dùng đơn vị tiền tệ này. Đổi đơn vị không quy đổi số tiền."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lahat ng gastos ay nasa currency na ito. Hindi iko-convert ang mga halaga kapag pinalitan ito."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm masraflar bu para birimini kullanır. Değiştirmek tutarları dönüştürmez."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُستخدم هذه العملة لجميع التكاليف. تغييرها لا يحوّل المبالغ."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все расходы указаны в этой валюте. При смене валюты суммы не конвертируются."
          }
        },
        "fil-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gagamitin ang currency na ito para sa lahat ng gastos. Hindi nako-convert ang mga halaga kapag binago ito."
          }
        }
      }
    },
    "Allow microphone and speech recognition in Settings, or type your answer." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow microphone and speech recognition in Settings, or type your answer."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در تنظیمات دسترسی میکروفون و تشخیص گفتار را فعال کنید، یا پاسخ را بنویسید."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite el acceso al micrófono y al reconocimiento de voz en Ajustes, o escribe tu respuesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez l’accès au micro et à la reconnaissance vocale dans Réglages, ou saisissez votre réponse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti l’accesso al microfono e al riconoscimento vocale nelle Impostazioni, oppure digita la risposta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定でマイクと音声認識を許可するか、回答を入力してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“设置”中允许使用麦克风和语音识别，或输入你的回答。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정에서 마이크와 음성 인식을 허용하거나 답변을 입력하세요."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho phép truy cập micrô và nhận dạng giọng nói trong Cài đặt, hoặc nhập câu trả lời."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Payagan ang mikropono at pagkilala sa pagsasalita sa Mga Setting, o i-type ang sagot mo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayarlar'dan mikrofona ve konuşma tanımaya izin verin ya da yanıtınızı yazın."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح بالوصول إلى الميكروفون والتعرّف على الكلام من «الإعدادات»، أو اكتب إجابتك."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите доступ к микрофону и распознаванию речи в настройках или введите ответ текстом."
          }
        },
        "fil-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Payagan ang paggamit ng mikropono at pagkilala ng boses sa Mga Setting, o i-type ang sagot mo."
          }
        }
      }
    },
