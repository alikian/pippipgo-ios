    "Review local dates, times and time zones before saving. Leave unknown fields blank; your plan will stay provisional." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "راجع التواريخ والأوقات ومناطقها المحلية قبل الحفظ. اترك الحقول غير المعروفة فارغة؛ ستظل خطتك مبدئية."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Review local dates, times and time zones before saving. Leave unknown fields blank; your plan will stay provisional."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa las fechas, horas y zonas horarias locales antes de guardar. Deja en blanco los campos desconocidos; tu plan seguirá siendo provisional."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پیش از ذخیره، تاریخ‌ها، ساعت‌ها و مناطق زمانی محلی را بررسی کنید. موارد نامشخص را خالی بگذارید؛ برنامه موقت باقی می‌ماند."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suriin ang mga lokal na petsa, oras, at time zone bago mag-save. Iwanang blangko ang mga hindi alam; mananatiling pansamantala ang plano mo."
          }
        },
        "fil-PH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suriin ang mga lokal na petsa, oras at time zone bago mag-save. Iwang blangko ang mga hindi alam; mananatiling pansamantala ang plano mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifie les dates, heures et fuseaux horaires locaux avant d’enregistrer. Laisse les champs inconnus vides ; ton programme restera provisoire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla date, orari e fusi orari locali prima di salvare. Lascia vuoti i campi sconosciuti; il piano resterà provvisorio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存前に現地の日付、時刻、タイムゾーンを確認してください。不明な項目は空欄にしてください。プランは仮のままになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장하기 전에 현지 날짜, 시간, 시간대를 확인하세요. 모르는 항목은 비워 두세요. 일정은 임시 상태로 유지됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перед сохранением проверьте местные даты, время и часовые пояса. Неизвестные поля оставьте пустыми — план пока будет предварительным."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydetmeden önce yerel tarihleri, saatleri ve saat dilimlerini kontrol edin. Bilinmeyen alanları boş bırakın; planınız geçici kalır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xem lại ngày, giờ và múi giờ địa phương trước khi lưu. Để trống những thông tin chưa biết; kế hoạch của bạn sẽ vẫn là bản tạm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存前请检查当地日期、时间和时区。未知项目请留空；计划将保持暂定状态。"
          }
        }
      }
    },
