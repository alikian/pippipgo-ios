<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>INAlternativeAppNames</key>
	<array>
		<dict>
			<key>INAlternativeAppName</key>
			<string>PipPipGo</string>
			<key>INAlternativeAppNamePronunciationHint</key>
			<string>Pip Pip Go</string>
		</dict>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>PipPipGo uses your location, including precise coordinates when allowed, for nearby travel suggestions and conversation context shared with OpenAI.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>NSMicrophoneUsageDescription</key>
	<string>Talk to Pip or translate conversations live. Audio is shared with OpenAI while voice or translation is active.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Turn your spoken trip plans into text for you to review before sending to Pip.</string>
	<key>CFBundleDisplayName</key>
	<string>$(PIPPIPGO_DISPLAY_NAME)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.pippipgo.ios.oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>pippipgo</string>
			</array>
		</dict>
	</array>
	<key>BackendBaseURL</key>
	<string>$(PIPPIPGO_BACKEND_BASE_URL)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>192.168.0.208</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Connect to the PipPipGo development backend on your Mac.</string>
	<key>AppEnvironment</key>
	<string>$(PIPPIPGO_APP_ENVIRONMENT)</string>
	<key>CognitoDomain</key>
	<string>$(PIPPIPGO_COGNITO_DOMAIN)</string>
	<key>CognitoClientID</key>
	<string>$(PIPPIPGO_COGNITO_CLIENT_ID)</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Choose calendars to check your travel plans for schedule conflicts. Calendar contents stay on this device.</string>
</dict>
</plist>
